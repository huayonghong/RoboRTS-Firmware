        <mxCell id="wqBeYj-3dv2jAloqyC1d-36" value="CAN2" style="endArrow=block;html=1;strokeWidth=2;fontSize=11;startArrow=block;startFill=1;" parent="wqBeYj-3dv2jAloqyC1d-21" source="wqBeYj-3dv2jAloqyC1d-29" target="WbKpN1WQK_JBk0jXsQlg-2" edge="1">
