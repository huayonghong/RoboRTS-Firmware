        <mxCell id="wqBeYj-3dv2jAloqyC1d-37" value="图例与说明" style="swimlane;horizontal=0;startSize=32;fontStyle=1;fontSize=13;fillColor=#FFF4CC;strokeColor=#D6B656;" parent="1" vertex="1">
