  <diagram id="ttHf3vOHDS_g5Y3A9rCF" name="Chassis Data Flow">
    <mxGraphModel dx="2305" dy="1243" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="wy10wUB_nNSXJ3Hr1SQs-1" value="DT7/DR16 Remote Controller to Chassis Motor Drive -- Complete Data Flow&#xa;RoboRTS-Firmware | DBUS Protocol | Mecanum Kinematics | CAN2 Motor Control" style="text;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=18;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="620" y="180" width="1100" height="55" as="geometry" />
        </mxCell>
        <mxCell id="wy10wUB_nNSXJ3Hr1SQs-2" value="Stage 1: Physical Hardware (DT7 + DR16)" style="swimlane;startSize=30;fillColor=#FF9999;strokeColor=#B85450;fontStyle=1;fontSize=14;rounded=1;" parent="1" vertex="1">
          <mxGeometry x="340" y="260" width="1660" height="220" as="geometry" />
        </mxCell>
        <mxCell id="wy10wUB_nNSXJ3Hr1SQs-3" value="DT7 Remote Controller&#xa;(Transmitter)&#xa;&#xa;2.4GHz Wireless&#xa;2 Joysticks (4 channels)&#xa;2 Toggle Switches (S1, S2)&#xa;1 Scroll Wheel" style="rounded=1;fillColor=#FF9999;strokeColor=#B85450;fontSize=11;whiteSpace=wrap;align=left;spacingLeft=8;fontStyle=0;" parent="wy10wUB_nNSXJ3Hr1SQs-2" vertex="1">
          <mxGeometry x="20" y="40" width="220" height="160" as="geometry" />
        </mxCell>
        <mxCell id="wy10wUB_nNSXJ3Hr1SQs-4" value="2.4GHz&#xa;Wireless" style="text;align=center;fontSize=11;fontStyle=2;fillColor=none;strokeColor=none;" parent="wy10wUB_nNSXJ3Hr1SQs-2" vertex="1">
          <mxGeometry x="260" y="80" width="80" height="40" as="geometry" />
        </mxCell>
        <mxCell id="wy10wUB_nNSXJ3Hr1SQs-5" value="DR16 Receiver&#xa;(DBUS Output)&#xa;&#xa;Wired connection to MCU&#xa;DBUS Serial Protocol&#xa;18 bytes per frame&#xa;~14ms frame interval" style="rounded=1;fillColor=#FFD699;strokeColor=#D79B00;fontSize=11;whiteSpace=wrap;align=left;spacingLeft=8;" parent="wy10wUB_nNSXJ3Hr1SQs-2" vertex="1">
          <mxGeometry x="360" y="40" width="220" height="160" as="geometry" />
        </mxCell>
        <mxCell id="wy10wUB_nNSXJ3Hr1SQs-6" value="DBUS 18-Byte Frame Structure:&#xa;&#xa;Byte[0-4]:  ch1(11bit) ch2(11bit) ch3(11bit)&#xa;Byte[4-5]:  ch4(11bit) + S1(2bit) S2(2bit)&#xa;Byte[6-11]: Mouse X(16) Y(16) Z(16)&#xa;Byte[12-13]: Mouse L/R button&#xa;Byte[14-15]: Keyboard key_code(16bit)&#xa;Byte[16-17]: Scroll wheel(16bit)" style="rounded=1;fillColor=#FFFFCC;strokeColor=#D6B656;fontSize=10;whiteSpace=wrap;align=left;spacingLeft=8;" parent="wy10wUB_nNSXJ3Hr1SQs-2" vertex="1">
          <mxGeometry x="620" y="40" width="340" height="160" as="geometry" />
        </mxCell>
        <mxCell id="wy10wUB_nNSXJ3Hr1SQs-7" value="Joystick Channel Mapping:&#xa;&#xa;ch1: Right X (left/right) range: -660~+660&#xa;ch2: Right Y (fwd/bwd)  range: -660~+660&#xa;ch3: Left X  (left/right) range: -660~+660&#xa;ch4: Left Y  (fwd/bwd)  range: -660~+660&#xa;S1/S2: 1=UP, 3=MID, 2=DOWN&#xa;Deadzone: |ch| &lt;= 5 -&gt; set to 0" style="rounded=1;fillColor=#FFFFCC;strokeColor=#D6B656;fontSize=10;whiteSpace=wrap;align=left;spacingLeft=8;" parent="wy10wUB_nNSXJ3Hr1SQs-2" vertex="1">
          <mxGeometry x="1000" y="40" width="330" height="160" as="geometry" />
        </mxCell>
        <mxCell id="wy10wUB_nNSXJ3Hr1SQs-8" style="endArrow=block;endFill=1;strokeWidth=3;strokeColor=#B85450;" parent="wy10wUB_nNSXJ3Hr1SQs-2" source="wy10wUB_nNSXJ3Hr1SQs-3" target="wy10wUB_nNSXJ3Hr1SQs-5" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="wy10wUB_nNSXJ3Hr1SQs-9" value="Stage 2: BSP UART Reception (drv_dr16.c + drv_uart.c)" style="swimlane;startSize=30;fillColor=#CCE5FF;strokeColor=#3399FF;fontStyle=1;fontSize=14;rounded=1;" parent="1" vertex="1">
          <mxGeometry x="340" y="520" width="1660" height="220" as="geometry" />
        </mxCell>
        <mxCell id="wy10wUB_nNSXJ3Hr1SQs-10" value="USART3 Hardware Config&#xa;&#xa;Baud: 100000 (8E1)&#xa;TX: PC10 | RX: PC11&#xa;DMA: RX Circular (DMA1_S1)&#xa;Buffer: 36 bytes (2 frames)&#xa;IDLE Interrupt Enabled" style="rounded=1;fillColor=#CCE5FF;strokeColor=#3399FF;fontSize=11;whiteSpace=wrap;align=left;spacingLeft=8;" parent="wy10wUB_nNSXJ3Hr1SQs-9" vertex="1">
          <mxGeometry x="20" y="40" width="250" height="155" as="geometry" />
        </mxCell>
        <mxCell id="wy10wUB_nNSXJ3Hr1SQs-11" value="USART3 IDLE IRQ Handler&#xa;dr16_uart_rx_data_handle()&#xa;&#xa;1. Check UART_FLAG_IDLE&#xa;2. Clear IDLE flag&#xa;3. Disable DMA&#xa;4. Check received length == 18&#xa;5. Call dr16_rx_callback(buff, 18)&#xa;6. Call dr16_forword_callback(buff, 18)&#xa;7. Reset DMA counter&#xa;8. Re-enable DMA" style="rounded=1;fillColor=#CCE5FF;strokeColor=#3399FF;fontSize=10;whiteSpace=wrap;align=left;spacingLeft=8;" parent="wy10wUB_nNSXJ3Hr1SQs-9" vertex="1">
          <mxGeometry x="310" y="40" width="300" height="155" as="geometry" />
        </mxCell>
        <mxCell id="wy10wUB_nNSXJ3Hr1SQs-12" value="dr16_uart_init() [board.c calls]&#xa;&#xa;UART_Receive_DMA_No_IT(&amp;huart3, buf, 36)&#xa;  Start DMA RX without interrupt&#xa;__HAL_UART_ENABLE_IT: IDLE IRQ&#xa;&#xa;Callbacks registered:&#xa;  rx_fn = dr16_rx_data_by_uart&#xa;  forword_fn = dr16_forward_by_can" style="rounded=1;fillColor=#E6F3FF;strokeColor=#3399FF;fontSize=10;whiteSpace=wrap;align=left;spacingLeft=8;" parent="wy10wUB_nNSXJ3Hr1SQs-9" vertex="1">
          <mxGeometry x="650" y="40" width="300" height="155" as="geometry" />
        </mxCell>
        <mxCell id="wy10wUB_nNSXJ3Hr1SQs-13" value="board.c: dr16_rx_data_by_uart()&#xa;&#xa;EventMsgPost(&amp;dbusPub,&#xa;  buff, DBUS_MSG_LEN)&#xa;&#xa;Publishes raw 18-byte DBUS&#xa;data to Event System as&#xa;DBUS_MSG event." style="rounded=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;whiteSpace=wrap;align=left;spacingLeft=8;" parent="wy10wUB_nNSXJ3Hr1SQs-9" vertex="1">
          <mxGeometry x="990" y="40" width="280" height="155" as="geometry" />
        </mxCell>
        <mxCell id="wy10wUB_nNSXJ3Hr1SQs-14" style="endArrow=block;endFill=1;strokeWidth=2;strokeColor=#3399FF;" parent="wy10wUB_nNSXJ3Hr1SQs-9" source="wy10wUB_nNSXJ3Hr1SQs-10" target="wy10wUB_nNSXJ3Hr1SQs-11" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="wy10wUB_nNSXJ3Hr1SQs-15" style="endArrow=block;endFill=1;strokeWidth=2;strokeColor=#3399FF;" parent="wy10wUB_nNSXJ3Hr1SQs-9" source="wy10wUB_nNSXJ3Hr1SQs-11" target="wy10wUB_nNSXJ3Hr1SQs-13" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="wy10wUB_nNSXJ3Hr1SQs-16" value="Stage 3: Event System + RC Data Parsing (event_mgr + dbus.c)" style="swimlane;startSize=30;fillColor=#E6FFE6;strokeColor=#82B366;fontStyle=1;fontSize=14;rounded=1;" parent="1" vertex="1">
          <mxGeometry x="340" y="780" width="1660" height="260" as="geometry" />
        </mxCell>
        <mxCell id="wy10wUB_nNSXJ3Hr1SQs-17" value="Event Manager&#xa;Publish-Subscribe&#xa;&#xa;Publisher: dbusPub&#xa;Event ID: DBUS_MSG&#xa;Data: 18 bytes raw&#xa;&#xa;Subscriber:&#xa;chassis_task subscribes&#xa;with SUBS_MODE_NORMAL" style="rounded=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;whiteSpace=wrap;align=left;spacingLeft=8;" parent="wy10wUB_nNSXJ3Hr1SQs-16" vertex="1">
          <mxGeometry x="20" y="40" width="230" height="200" as="geometry" />
        </mxCell>
        <mxCell id="wy10wUB_nNSXJ3Hr1SQs-18" value="chassis_task Main Loop&#xa;&#xa;EventMsgProcess(&amp;listSubs, 0)&#xa;  -&gt; triggers callback:&#xa;&#xa;chassis_dr16_data_update()&#xa;  rc_device_date_update(&#xa;    &amp;chassis_rc, pMsgData)&#xa;&#xa;This calls:&#xa;  get_dr16_data() + get_dr16_state()" style="rounded=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=10;whiteSpace=wrap;align=left;spacingLeft=8;" parent="wy10wUB_nNSXJ3Hr1SQs-16" vertex="1">
          <mxGeometry x="290" y="40" width="280" height="200" as="geometry" />
        </mxCell>
        <mxCell id="wy10wUB_nNSXJ3Hr1SQs-19" value="get_dr16_data() -- Bit Field Parsing&#xa;&#xa;ch1 = (buf[0]|buf[1]&lt;&lt;8) &amp; 0x7FF - 1024&#xa;ch2 = (buf[1]&gt;&gt;3|buf[2]&lt;&lt;5) &amp; 0x7FF - 1024&#xa;ch3 = (buf[2]&gt;&gt;6|buf[3]&lt;&lt;2|buf[4]&lt;&lt;10) - 1024&#xa;ch4 = (buf[4]&gt;&gt;1|buf[5]&lt;&lt;7) &amp; 0x7FF - 1024&#xa;&#xa;Deadzone filter: |ch| &lt;= 5 -&gt; 0&#xa;Overflow check: |ch| &gt; 660 -&gt; clear all&#xa;&#xa;sw1 = ((buf[5]&gt;&gt;4) &amp; 0x0C) &gt;&gt; 2&#xa;sw2 = (buf[5]&gt;&gt;4) &amp; 0x03" style="rounded=1;fillColor=#FFFFCC;strokeColor=#D6B656;fontSize=10;whiteSpace=wrap;align=left;spacingLeft=8;" parent="wy10wUB_nNSXJ3Hr1SQs-16" vertex="1">
          <mxGeometry x="610" y="40" width="340" height="200" as="geometry" />
        </mxCell>
        <mxCell id="wy10wUB_nNSXJ3Hr1SQs-20" value="get_dr16_state() -- Switch Tracking&#xa;&#xa;S1 states: RC_S1_UP / MID / DOWN&#xa;S2 states: RC_S2_UP / MID / DOWN&#xa;&#xa;Transition events tracked:&#xa;  RC_S1_UP2MID, RC_S1_MID2UP&#xa;  RC_S1_DOWN2MID, RC_S1_MID2DOWN&#xa;  RC_S2_UP2MID, RC_S2_MID2UP&#xa;  RC_S2_DOWN2MID, RC_S2_MID2DOWN&#xa;&#xa;Used for mode switching detection" style="rounded=1;fillColor=#FFFFCC;strokeColor=#D6B656;fontSize=10;whiteSpace=wrap;align=left;spacingLeft=8;" parent="wy10wUB_nNSXJ3Hr1SQs-16" vertex="1">
          <mxGeometry x="990" y="40" width="320" height="200" as="geometry" />
        </mxCell>
        <mxCell id="wy10wUB_nNSXJ3Hr1SQs-21" style="endArrow=block;endFill=1;strokeWidth=2;strokeColor=#82B366;" parent="wy10wUB_nNSXJ3Hr1SQs-16" source="wy10wUB_nNSXJ3Hr1SQs-17" target="wy10wUB_nNSXJ3Hr1SQs-18" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="wy10wUB_nNSXJ3Hr1SQs-22" style="endArrow=block;endFill=1;strokeWidth=2;strokeColor=#82B366;" parent="wy10wUB_nNSXJ3Hr1SQs-16" source="wy10wUB_nNSXJ3Hr1SQs-18" target="wy10wUB_nNSXJ3Hr1SQs-19" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="wy10wUB_nNSXJ3Hr1SQs-23" style="endArrow=block;endFill=1;strokeWidth=2;strokeColor=#D6B656;" parent="wy10wUB_nNSXJ3Hr1SQs-16" source="wy10wUB_nNSXJ3Hr1SQs-19" target="wy10wUB_nNSXJ3Hr1SQs-20" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="wy10wUB_nNSXJ3Hr1SQs-24" value="Stage 4: Chassis Task Mode Decision (chassis_task.c)" style="swimlane;startSize=30;fillColor=#FFE6CC;strokeColor=#D79B00;fontStyle=1;fontSize=14;rounded=1;" parent="1" vertex="1">
          <mxGeometry x="340" y="1080" width="1660" height="350" as="geometry" />
        </mxCell>
        <mxCell id="wy10wUB_nNSXJ3Hr1SQs-25" value="S2 Switch&#xa;Mode Selector&#xa;&#xa;rc_device_get_state()&#xa;checks S2 position&#xa;to decide control mode" style="rounded=1;fillColor=#FFD699;strokeColor=#D79B00;fontSize=11;whiteSpace=wrap;fontStyle=1;" parent="wy10wUB_nNSXJ3Hr1SQs-24" vertex="1">
          <mxGeometry x="20" y="60" width="180" height="120" as="geometry" />
        </mxCell>
        <mxCell id="wy10wUB_nNSXJ3Hr1SQs-26" value="S2 = UP: Follow Mode&#xa;&#xa;vx = ch2/660 * MAX_VX_SPEED&#xa;vy = -ch1/660 * MAX_VY_SPEED&#xa;wz = -pid_follow(relative_angle, 0)&#xa;&#xa;Chassis follows gimbal yaw angle.&#xa;follow_relative_angle from gimbal&#xa;via protocol CMD_GIMBAL_INFO.&#xa;&#xa;Rotation offset:&#xa;  ROTATE_X/Y_OFFSET applied" style="rounded=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=10;whiteSpace=wrap;align=left;spacingLeft=8;" parent="wy10wUB_nNSXJ3Hr1SQs-24" vertex="1">
          <mxGeometry x="260" y="40" width="300" height="200" as="geometry" />
        </mxCell>
        <mxCell id="wy10wUB_nNSXJ3Hr1SQs-27" value="S2 = MID: Direct Control&#xa;&#xa;vx = ch2/660 * MAX_VX_SPEED&#xa;vy = -ch1/660 * MAX_VY_SPEED&#xa;wz = -ch3/660 * MAX_VW_SPEED&#xa;&#xa;Direct joystick mapping:&#xa;  Right stick Y -&gt; forward/back&#xa;  Right stick X -&gt; strafe left/right&#xa;  Left stick X -&gt; rotation&#xa;&#xa;Rotation offset: (0, 0)" style="rounded=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=10;whiteSpace=wrap;align=left;spacingLeft=8;" parent="wy10wUB_nNSXJ3Hr1SQs-24" vertex="1">
          <mxGeometry x="600" y="40" width="300" height="200" as="geometry" />
        </mxCell>
        <mxCell id="wy10wUB_nNSXJ3Hr1SQs-28" value="S2 = DOWN: SDK Mode&#xa;&#xa;Chassis controlled by PC/Manifold2&#xa;via protocol commands.&#xa;&#xa;set_chassis_sdk_mode(ON)&#xa;Enable Manifold2 heartbeat monitor&#xa;Enable control cmd monitor&#xa;&#xa;Special combo for motor ID set:&#xa;ch1&lt;-400 &amp; ch2&lt;-400 &amp;&#xa;ch3&gt;400 &amp; ch4&lt;-400 for 2s" style="rounded=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=10;whiteSpace=wrap;align=left;spacingLeft=8;" parent="wy10wUB_nNSXJ3Hr1SQs-24" vertex="1">
          <mxGeometry x="940" y="40" width="300" height="200" as="geometry" />
        </mxCell>
        <mxCell id="wy10wUB_nNSXJ3Hr1SQs-29" value="chassis_set_speed(&amp;chassis, vx, vy, wz)&#xa;&#xa;Writes to: chassis.mecanum.speed.vx/vy/vw&#xa;chassis_set_offset(): rotation center offset&#xa;chassis_set_acc(): acceleration (0 for RC)" style="rounded=1;fillColor=#FFD699;strokeColor=#D79B00;fontSize=11;whiteSpace=wrap;align=left;spacingLeft=8;fontStyle=1;" parent="wy10wUB_nNSXJ3Hr1SQs-24" vertex="1">
          <mxGeometry x="260" y="265" width="640" height="70" as="geometry" />
        </mxCell>
        <mxCell id="wy10wUB_nNSXJ3Hr1SQs-30" value="S2=UP" style="endArrow=block;endFill=1;strokeWidth=2;strokeColor=#82B366;" parent="wy10wUB_nNSXJ3Hr1SQs-24" source="wy10wUB_nNSXJ3Hr1SQs-25" target="wy10wUB_nNSXJ3Hr1SQs-26" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="wy10wUB_nNSXJ3Hr1SQs-31" value="S2=MID" style="endArrow=block;endFill=1;strokeWidth=2;strokeColor=#6C8EBF;" parent="wy10wUB_nNSXJ3Hr1SQs-24" source="wy10wUB_nNSXJ3Hr1SQs-25" target="wy10wUB_nNSXJ3Hr1SQs-27" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="wy10wUB_nNSXJ3Hr1SQs-32" value="S2=DOWN" style="endArrow=block;endFill=1;strokeWidth=2;strokeColor=#9673A6;" parent="wy10wUB_nNSXJ3Hr1SQs-24" source="wy10wUB_nNSXJ3Hr1SQs-25" target="wy10wUB_nNSXJ3Hr1SQs-28" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="wy10wUB_nNSXJ3Hr1SQs-33" style="endArrow=block;endFill=1;strokeWidth=2;strokeColor=#D79B00;" parent="wy10wUB_nNSXJ3Hr1SQs-24" source="wy10wUB_nNSXJ3Hr1SQs-26" target="wy10wUB_nNSXJ3Hr1SQs-29" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="wy10wUB_nNSXJ3Hr1SQs-34" style="endArrow=block;endFill=1;strokeWidth=2;strokeColor=#D79B00;" parent="wy10wUB_nNSXJ3Hr1SQs-24" source="wy10wUB_nNSXJ3Hr1SQs-27" target="wy10wUB_nNSXJ3Hr1SQs-29" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="wy10wUB_nNSXJ3Hr1SQs-35" value="Stage 5: Mecanum Inverse Kinematics (mecanum.c + chassis.c)" style="swimlane;startSize=30;fillColor=#E1D5E7;strokeColor=#9673A6;fontStyle=1;fontSize=14;rounded=1;" parent="1" vertex="1">
          <mxGeometry x="340" y="1470" width="1660" height="330" as="geometry" />
        </mxCell>
        <mxCell id="wy10wUB_nNSXJ3Hr1SQs-36" value="Soft Timer Trigger&#xa;Period: 5ms&#xa;&#xa;chassis_pid_calculate()&#xa;called every 5ms" style="rounded=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;whiteSpace=wrap;fontStyle=1;" parent="wy10wUB_nNSXJ3Hr1SQs-35" vertex="1">
          <mxGeometry x="20" y="40" width="180" height="100" as="geometry" />
        </mxCell>
        <mxCell id="wy10wUB_nNSXJ3Hr1SQs-37" value="mecanum_calculate(&amp;chassis.mecanum)&#xa;&#xa;Input: speed.vx (mm/s), speed.vy (mm/s), speed.vw (deg/s)&#xa;&#xa;1. Clamp to MAX_VX/VY/VW_SPEED&#xa;2. Calculate rotate_ratio per wheel:&#xa;   ratio = (wheelbase + wheeltrack)/2 +/- offsets&#xa;3. wheel_rpm_ratio = 60 / (perimeter * DECELE_RATIO)&#xa;&#xa;4. Mecanum IK formula:&#xa;   FR = (-vx - vy - vw*ratio_fr) * rpm_ratio&#xa;   FL = (+vx - vy - vw*ratio_fl) * rpm_ratio&#xa;   BL = (+vx + vy - vw*ratio_bl) * rpm_ratio&#xa;   BR = (-vx + vy - vw*ratio_br) * rpm_ratio&#xa;&#xa;5. If max &gt; MAX_WHEEL_RPM: scale proportionally" style="rounded=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=10;whiteSpace=wrap;align=left;spacingLeft=8;" parent="wy10wUB_nNSXJ3Hr1SQs-35" vertex="1">
          <mxGeometry x="240" y="40" width="450" height="270" as="geometry" />
        </mxCell>
        <mxCell id="wy10wUB_nNSXJ3Hr1SQs-38" value="Mecanum Parameters&#xa;&#xa;PERIMETER: wheel circumference (mm)&#xa;WHEELTRACK: wheel-to-wheel width&#xa;WHEELBASE: front-to-rear distance&#xa;ROTATE_X_OFFSET: rotation center X&#xa;ROTATE_Y_OFFSET: rotation center Y&#xa;MOTOR_DECELE_RATIO: gear ratio&#xa;MAX_WHEEL_RPM: max motor RPM" style="rounded=1;fillColor=#FFFFCC;strokeColor=#D6B656;fontSize=10;whiteSpace=wrap;align=left;spacingLeft=8;" parent="wy10wUB_nNSXJ3Hr1SQs-35" vertex="1">
          <mxGeometry x="730" y="40" width="280" height="160" as="geometry" />
        </mxCell>
        <mxCell id="wy10wUB_nNSXJ3Hr1SQs-39" value="Output: wheel_rpm[4]&#xa;&#xa;wheel_rpm[0] = FR motor target RPM&#xa;wheel_rpm[1] = FL motor target RPM&#xa;wheel_rpm[2] = BL motor target RPM&#xa;wheel_rpm[3] = BR motor target RPM&#xa;&#xa;Used as PID setpoint in next step" style="rounded=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=10;whiteSpace=wrap;align=left;spacingLeft=8;" parent="wy10wUB_nNSXJ3Hr1SQs-35" vertex="1">
          <mxGeometry x="730" y="215" width="280" height="95" as="geometry" />
        </mxCell>
        <mxCell id="wy10wUB_nNSXJ3Hr1SQs-40" value="Wheel Layout (Top View)&#xa;&#xa;    Front&#xa;  [FL]--[FR]&#xa;   |       |&#xa;   |   C   |&#xa;   |       |&#xa;  [BL]--[BR]&#xa;     Rear&#xa;&#xa;FR=0x201 FL=0x202&#xa;BL=0x203 BR=0x204" style="rounded=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=10;whiteSpace=wrap;fontFamily=monospace;" parent="wy10wUB_nNSXJ3Hr1SQs-35" vertex="1">
          <mxGeometry x="1050" y="40" width="220" height="210" as="geometry" />
        </mxCell>
        <mxCell id="wy10wUB_nNSXJ3Hr1SQs-41" style="endArrow=block;endFill=1;strokeWidth=2;strokeColor=#9673A6;" parent="wy10wUB_nNSXJ3Hr1SQs-35" source="wy10wUB_nNSXJ3Hr1SQs-36" target="wy10wUB_nNSXJ3Hr1SQs-37" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="wy10wUB_nNSXJ3Hr1SQs-42" value="Stage 6: Motor Speed PID Control (chassis.c)" style="swimlane;startSize=30;fillColor=#D5E8D4;strokeColor=#82B366;fontStyle=1;fontSize=14;rounded=1;" parent="1" vertex="1">
          <mxGeometry x="340" y="1840" width="1660" height="280" as="geometry" />
        </mxCell>
        <mxCell id="wy10wUB_nNSXJ3Hr1SQs-43" value="PID Loop (4 motors, each 5ms)&#xa;&#xa;for i in [0..3]:&#xa;  actual = motor[i].data.speed_rpm&#xa;  target = chassis.mecanum.wheel_rpm[i]&#xa;&#xa;  motor_out = pid_calculate(&#xa;    &amp;motor_pid[i],&#xa;    actual,   // feedback (CAN RX)&#xa;    target    // setpoint (mecanum IK)&#xa;  )&#xa;&#xa;  motor_set_current(&#xa;    &amp;motor[i],&#xa;    (int16_t)motor_out&#xa;  )" style="rounded=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=10;whiteSpace=wrap;align=left;spacingLeft=8;" parent="wy10wUB_nNSXJ3Hr1SQs-42" vertex="1">
          <mxGeometry x="20" y="40" width="310" height="220" as="geometry" />
        </mxCell>
        <mxCell id="wy10wUB_nNSXJ3Hr1SQs-44" value="PID Parameters&#xa;(chassis_motor_param)&#xa;&#xa;Kp = 6.5&#xa;Ki = 0.1&#xa;Kd = 0.0&#xa;max_out = 15000&#xa;integral_limit = 500&#xa;&#xa;Output: motor current&#xa;Range: -15000 ~ +15000" style="rounded=1;fillColor=#FFFFCC;strokeColor=#D6B656;fontSize=11;whiteSpace=wrap;align=left;spacingLeft=8;" parent="wy10wUB_nNSXJ3Hr1SQs-42" vertex="1">
          <mxGeometry x="370" y="40" width="230" height="220" as="geometry" />
        </mxCell>
        <mxCell id="wy10wUB_nNSXJ3Hr1SQs-45" value="pid_calculate() Algorithm&#xa;&#xa;error = setpoint - measurement&#xa;P_out = Kp * error&#xa;I_out = Ki * sum(error) [clamped]&#xa;D_out = Kd * d(error)/dt&#xa;&#xa;output = P_out + I_out + D_out&#xa;output = clamp(output, -max_out, +max_out)&#xa;&#xa;If pid.enable == 0: output = 0&#xa;(disabled when offline)" style="rounded=1;fillColor=#E6FFE6;strokeColor=#82B366;fontSize=10;whiteSpace=wrap;align=left;spacingLeft=8;" parent="wy10wUB_nNSXJ3Hr1SQs-42" vertex="1">
          <mxGeometry x="640" y="40" width="290" height="220" as="geometry" />
        </mxCell>
        <mxCell id="wy10wUB_nNSXJ3Hr1SQs-46" value="Feedback Source:&#xa;CAN2 RX 0x201~0x204&#xa;&#xa;motor_data_update() decodes:&#xa;  ecd (encoder, 0-8191)&#xa;  speed_rpm (actual RPM)&#xa;  given_current (actual mA)&#xa;&#xa;speed_rpm is used as&#xa;PID feedback (actual value)" style="rounded=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10;whiteSpace=wrap;align=left;spacingLeft=8;" parent="wy10wUB_nNSXJ3Hr1SQs-42" vertex="1">
          <mxGeometry x="970" y="40" width="260" height="190" as="geometry" />
        </mxCell>
        <mxCell id="wy10wUB_nNSXJ3Hr1SQs-47" value="speed_rpm feedback" style="endArrow=block;endFill=1;strokeWidth=2;strokeColor=#D6B656;dashed=1;" parent="wy10wUB_nNSXJ3Hr1SQs-42" source="wy10wUB_nNSXJ3Hr1SQs-46" target="wy10wUB_nNSXJ3Hr1SQs-43" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="wy10wUB_nNSXJ3Hr1SQs-48" value="Stage 7: CAN2 Motor Output (motor.c + drv_can.c)" style="swimlane;startSize=30;fillColor=#FFE6CC;strokeColor=#D79B00;fontStyle=1;fontSize=14;rounded=1;" parent="1" vertex="1">
          <mxGeometry x="340" y="2160" width="1660" height="290" as="geometry" />
        </mxCell>
        <mxCell id="wy10wUB_nNSXJ3Hr1SQs-49" value="Soft Timer&#xa;Period: 1ms&#xa;&#xa;motor_can_output()&#xa;called every 1ms" style="rounded=1;fillColor=#FFD699;strokeColor=#D79B00;fontSize=11;whiteSpace=wrap;fontStyle=1;" parent="wy10wUB_nNSXJ3Hr1SQs-48" vertex="1">
          <mxGeometry x="20" y="40" width="160" height="100" as="geometry" />
        </mxCell>
        <mxCell id="wy10wUB_nNSXJ3Hr1SQs-50" value="motor_fill_data()&#xa;&#xa;Iterate all registered motors.&#xa;For each motor with can_id &lt; 0x205:&#xa;  Pack into msg ID=0x200&#xa;&#xa;motor_msg[CAN2][0].id = 0x200&#xa;  data[(can_id-0x201)*2]   = current &gt;&gt; 8&#xa;  data[(can_id-0x201)*2+1] = current &amp; 0xFF" style="rounded=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=10;whiteSpace=wrap;align=left;spacingLeft=8;" parent="wy10wUB_nNSXJ3Hr1SQs-48" vertex="1">
          <mxGeometry x="220" y="40" width="310" height="160" as="geometry" />
        </mxCell>
        <mxCell id="wy10wUB_nNSXJ3Hr1SQs-51" value="CAN2 TX Frame: StdId 0x200&#xa;&#xa;Byte[0-1]: Motor 0x201 (FR) current&#xa;Byte[2-3]: Motor 0x202 (FL) current&#xa;Byte[4-5]: Motor 0x203 (BL) current&#xa;Byte[6-7]: Motor 0x204 (BR) current&#xa;&#xa;8 bytes, sent every 1ms&#xa;via motor_can_send(CAN2, msg)" style="rounded=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;whiteSpace=wrap;align=left;spacingLeft=8;" parent="wy10wUB_nNSXJ3Hr1SQs-48" vertex="1">
          <mxGeometry x="570" y="40" width="320" height="170" as="geometry" />
        </mxCell>
