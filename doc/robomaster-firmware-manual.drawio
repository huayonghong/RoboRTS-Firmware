        <mxCell id="WbKpN1WQK_JBk0jXsQlg-3" value="CAN1 总线&lt;br&gt;（双板对绞 / 航插）&lt;br&gt;&lt;br&gt;应用层协议 +&lt;br&gt;CMD_PUSH_GIMBAL_INFO 等&lt;br&gt;&lt;br&gt;0x401 车体 yaw" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F0F0;strokeColor=#666666;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="wqBeYj-3dv2jAloqyC1d-21">
