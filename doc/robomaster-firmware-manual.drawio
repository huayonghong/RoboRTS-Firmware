        <mxCell id="eNYUcsIyRo49kigFaYzq-681" value="NO OLED: LED_B indicates Manifold2 status.&#xa;No screen feedback available." style="rounded=0;fillColor=#FFFFFF;fontSize=10;whiteSpace=wrap;" parent="eNYUcsIyRo49kigFaYzq-534" vertex="1">
