        <mxCell id="eNYUcsIyRo49kigFaYzq-628" value="Protocol local address,&#xa;CMD recv table, offline table,&#xa;Route table (Chassis/Gimbal/PC),&#xa;Communicate thread (1ms cycle)" style="rounded=0;fillColor=#DDEEFF;fontSize=10;whiteSpace=wrap;" parent="eNYUcsIyRo49kigFaYzq-534" vertex="1">
          <mxGeometry x="1090" y="1040" width="370" height="100" as="geometry" />
