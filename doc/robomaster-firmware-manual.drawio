        </mxCell>
        <mxCell id="WbKpN1WQK_JBk0jXsQlg-1" value="&lt;span style=&quot;&quot;&gt;&amp;lt;&amp;lt;执行节点&amp;gt;&amp;gt;&lt;/span&gt;&lt;br style=&quot;&quot;&gt;&lt;span style=&quot;&quot;&gt;云台控制板（MCU）&lt;/span&gt;&lt;br style=&quot;&quot;&gt;&lt;br style=&quot;&quot;&gt;&lt;span style=&quot;&quot;&gt;固件：gimbal_app（APP_CONFIG ≠ CHASSIS_APP）&lt;/span&gt;&lt;br style=&quot;&quot;&gt;&lt;span style=&quot;&quot;&gt;local_addr = GIMBAL_ADDRESS (0x02)&lt;/span&gt;&lt;br style=&quot;&quot;&gt;&lt;br style=&quot;&quot;&gt;&lt;span style=&quot;&quot;&gt;· CAN1：与底盘板互连（协议封装 + 广播云台信息）&lt;/span&gt;&lt;br style=&quot;&quot;&gt;&lt;span style=&quot;&quot;&gt;本板 TX 0x600 / RX 0x500&lt;/span&gt;&lt;br style=&quot;&quot;&gt;&lt;span style=&quot;&quot;&gt;· CAN2：云台电机（如 0x205/206/207 反馈）&lt;/span&gt;&lt;br style=&quot;&quot;&gt;&lt;span style=&quot;&quot;&gt;· DBus：接收机 → board.c dr16_uart&lt;/span&gt;&lt;br style=&quot;&quot;&gt;&lt;span style=&quot;&quot;&gt;· USART1：调试 Shell&lt;/span&gt;&lt;br style=&quot;&quot;&gt;&lt;span style=&quot;&quot;&gt;· USART6：裁判系统串口（board 配置）&lt;/span&gt;&lt;br style=&quot;&quot;&gt;&lt;span style=&quot;&quot;&gt;· BMI088：云台 IMU&lt;/span&gt;&lt;br style=&quot;&quot;&gt;&lt;span style=&quot;&quot;&gt;· USB：可选；未接时上位机指令多经 CAN 转发&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F0F0;strokeColor=#666666;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="wqBeYj-3dv2jAloqyC1d-21">
          <mxGeometry x="560" y="140" width="520" height="300" as="geometry" />
        </mxCell>
        <mxCell id="WbKpN1WQK_JBk0jXsQlg-2" value="&lt;span style=&quot;&quot;&gt;&amp;lt;&amp;lt;执行节点&amp;gt;&amp;gt;&lt;/span&gt;&lt;br style=&quot;&quot;&gt;&lt;span style=&quot;&quot;&gt;底盘控制板（MCU）&lt;/span&gt;&lt;br style=&quot;&quot;&gt;&lt;br style=&quot;&quot;&gt;&lt;span style=&quot;&quot;&gt;固件：chassis_app（APP_CONFIG = CHASSIS_APP）&lt;/span&gt;&lt;br style=&quot;&quot;&gt;&lt;span style=&quot;&quot;&gt;local_addr = CHASSIS_ADDRESS (0x01)&lt;/span&gt;&lt;br style=&quot;&quot;&gt;&lt;br style=&quot;&quot;&gt;&lt;span style=&quot;&quot;&gt;· CAN1：与云台板互连&lt;/span&gt;&lt;br style=&quot;&quot;&gt;&lt;span style=&quot;&quot;&gt;本板 TX 0x500 / RX 0x600&lt;/span&gt;&lt;br style=&quot;&quot;&gt;&lt;span style=&quot;&quot;&gt;· CAN2：麦克纳姆四轮电机（0x201–204）&lt;/span&gt;&lt;br style=&quot;&quot;&gt;&lt;span style=&quot;&quot;&gt;· USB VCP：典型接法 — 机载电脑 / 调试（MANIFOLD2 → usb）&lt;/span&gt;&lt;br style=&quot;&quot;&gt;&lt;span style=&quot;&quot;&gt;· 车体 yaw 广播：CAN1 StdId 0x401（非 protocol 载荷）&lt;/span&gt;&lt;br style=&quot;&quot;&gt;&lt;span style=&quot;&quot;&gt;· 裁判串口、DBus：与具体 PCB 一致（本工程 board 双板共用外设表）&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F0F0;strokeColor=#666666;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="wqBeYj-3dv2jAloqyC1d-21">
