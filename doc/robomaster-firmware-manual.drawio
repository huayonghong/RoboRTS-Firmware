        <mxCell id="kGnfXo39ut4HiMZHzzJg-17" value="当 chassis_rc：RC_S2_UP&#xa;&#xa;vx = ch2 映射 MAX_CHASSIS_VX&#xa;vy = -ch1 映射 MAX_CHASSIS_VY&#xa;wz = -pid_calculate(&amp;pid_follow,&#xa;      follow_relative_angle, 0)&#xa;&#xa;chassis_set_offset(ROTATE_X/Y)&#xa;chassis_set_speed(vx, vy, wz)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=left;spacingLeft=14;spacingTop=10;fillColor=#FFF2CC;verticalAlign=top;" parent="kGnfXo39ut4HiMZHzzJg-14" vertex="1">
          <mxGeometry x="40" y="145" width="420" height="240" as="geometry" />
        </mxCell>
        <mxCell id="kGnfXo39ut4HiMZHzzJg-18" value="follow_relative_angle 来源&#xa;&#xa;协议 CMD_PUSH_GIMBAL_INFO&#xa;→ follow_angle_info_rcv()&#xa;follow_relative_angle =&#xa;  info-&gt;yaw_ecd_angle / 10.0f&#xa;&#xa;（云台板 gimbal_info_push 广播经 CAN1）" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=left;spacingLeft=14;spacingTop=10;verticalAlign=top;" parent="kGnfXo39ut4HiMZHzzJg-14" vertex="1">
          <mxGeometry x="500" y="145" width="420" height="240" as="geometry" />
        </mxCell>
        <mxCell id="kGnfXo39ut4HiMZHzzJg-19" value="SoftTimer 5ms&#xa;chassis_pid_calculate&#xa;→ 麦克纳姆解算 + motor 电流&#xa;&#xa;SoftTimer 10ms&#xa;chassis_angle_broadcast&#xa;→ CAN1 0x401 发车体 yaw / yaw_rate&#xa;供云台融合" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=left;spacingLeft=12;verticalAlign=top;" parent="kGnfXo39ut4HiMZHzzJg-14" vertex="1">
          <mxGeometry x="960" y="145" width="480" height="240" as="geometry" />
        </mxCell>
        <mxCell id="kGnfXo39ut4HiMZHzzJg-20" value="闭合关系（底盘随动时）" style="swimlane;horizontal=0;startSize=32;fontSize=13;fillColor=#F5F5F5;strokeColor=#666666;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="440" y="1415" width="1480" height="280" as="geometry" />
        </mxCell>
        <mxCell id="kGnfXo39ut4HiMZHzzJg-21" value="1）云台转动 → 编码器/yaw 变化 → gimbal_info_push（约 10ms）推送 CMD_PUSH_GIMBAL_INFO → 底盘更新 follow_relative_angle。&#xa;&#xa;2）底盘 PID 把相对角误差转成 wz → 车体转向，使机身 yaw 跟上云台指向（平移 vx、vy 仍由底盘摇杆 ch1/ch2）。&#xa;&#xa;3）底盘 chassis_angle_broadcast（10ms）把车体 yaw、yaw_rate 发到 CAN 0x401 → 云台 gimbal_gyro_yaw_update，参与云台 yaw 陀螺支路。&#xa;&#xa;结论：开启底盘随动并不会「接管」云台；云台运动仍由云台任务与遥控器/SDK 决定，底盘仅根据推送角做车体旋转闭环。" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=18;spacingTop=14;fontSize=12;verticalAlign=top;" parent="kGnfXo39ut4HiMZHzzJg-20" vertex="1">
          <mxGeometry x="40" y="50" width="1400" height="210" as="geometry" />
        </mxCell>
        <mxCell id="kGnfXo39ut4HiMZHzzJg-22" value="代码：chassis_task.c（RC_S2_UP、pid_follow、follow_angle_info_rcv）· gimbal_task.c（gimbal_normol_handle、switch gimbal_mode）· gimbal_app.c（can1 回调）· gimbal_cmd.c（gimbal_info_push）" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=12;fontColor=#666666;" parent="1" vertex="1">
          <mxGeometry x="440" y="2315" width="1460" height="40" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="-5xHIgHWRut2nwEzeVza" name="第 6 页">
    <mxGraphModel dx="2305" dy="1243" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="Dmo2ccgEJF_z-c5CkqbE-1" value="RoboRTS-Firmware：双 MCU（底盘 + 云台）时遥控接收机接法" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=16;fontStyle=1" parent="1" vertex="1">
          <mxGeometry x="770" y="490" width="720" height="30" as="geometry" />
        </mxCell>
        <mxCell id="Dmo2ccgEJF_z-c5CkqbE-2" value="DR16 遥控接收机&#xa;(DBUS 串口)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1" parent="1" vertex="1">
          <mxGeometry x="650" y="590" width="160" height="70" as="geometry" />
        </mxCell>
        <mxCell id="Dmo2ccgEJF_z-c5CkqbE-3" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#1f6286;fontStyle=1" parent="1" source="Dmo2ccgEJF_z-c5CkqbE-2" target="Dmo2ccgEJF_z-c5CkqbE-5" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Dmo2ccgEJF_z-c5CkqbE-4" value="推荐：USART(DBUS)&#xa;唯一物理连接" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontColor=#1f6286;fontStyle=1" parent="Dmo2ccgEJF_z-c5CkqbE-3" vertex="1" connectable="0">
          <mxGeometry x="-0.2" y="1" relative="1" as="geometry">
            <mxPoint x="20" y="-18" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="Dmo2ccgEJF_z-c5CkqbE-5" value="MCU-A：底盘板&#xa;(APP = CHASSIS / chassis_app)&#xa;&#xa;• UART3：DR16 数据入队 DBUS 事件&#xa;• chassis_task 订阅 DBUS 控底盘&#xa;• dr16_forward_by_can：广播&#xa;  CMD_RC_DATA_FORWORD 到 CAN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="930" y="550" width="320" height="150" as="geometry" />
        </mxCell>
        <mxCell id="Dmo2ccgEJF_z-c5CkqbE-6" value="机载电脑 / USB&#xa;(Manifold，可选)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1">
          <mxGeometry x="930" y="730" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="Dmo2ccgEJF_z-c5CkqbE-7" style="endArrow=classic;html=1;dashed=1;strokeColor=#666666" parent="1" source="Dmo2ccgEJF_z-c5CkqbE-6" target="Dmo2ccgEJF_z-c5CkqbE-5" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Dmo2ccgEJF_z-c5CkqbE-8" value="CAN1 互联&#xa;(RoboMaster 协议：&#xa;0x500 ↔ 0x600 等)" style="shape=flexArrow;endArrow=classic;startArrow=classic;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1" parent="1" vertex="1">
          <mxGeometry x="970" y="830" width="360" height="40" as="geometry" />
        </mxCell>
        <mxCell id="Dmo2ccgEJF_z-c5CkqbE-9" value="MCU-B：云台板&#xa;(APP = GIMBAL / gimbal_app)&#xa;&#xa;• 可不接 DR16 硬件&#xa;• 收 CAN 上 CMD_RC_DATA_FORWORD&#xa;  → dr16_rx_data_by_can&#xa;  → 与本地相同 DBUS 流&#xa;• gimbal_task 订阅 DBUS 控云台" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="930" y="900" width="320" height="150" as="geometry" />
        </mxCell>
        <mxCell id="Dmo2ccgEJF_z-c5CkqbE-10" style="endArrow=classic;html=1;entryX=0.5;entryY=0;exitX=0.5;exitY=1;strokeWidth=2" parent="1" source="Dmo2ccgEJF_z-c5CkqbE-5" target="Dmo2ccgEJF_z-c5CkqbE-8" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Dmo2ccgEJF_z-c5CkqbE-11" style="endArrow=classic;html=1;entryX=0.5;entryY=0;exitX=0.5;exitY=0;strokeWidth=2" parent="1" source="Dmo2ccgEJF_z-c5CkqbE-8" target="Dmo2ccgEJF_z-c5CkqbE-9" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1150" y="870" as="sourcePoint" />
            <mxPoint x="1090" y="900" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="Dmo2ccgEJF_z-c5CkqbE-12" value="备选：接收机也可接在云台板 UART，固件同样会 forward 到 CAN，&#xa;底盘板经 CMD_RC_DATA_FORWORD 注入 DBUS。工程上更常见是接底盘。" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffc0;strokeColor=#ff9900;align=left;spacingLeft=6" parent="1" vertex="1">
          <mxGeometry x="650" y="750" width="220" height="100" as="geometry" />
        </mxCell>
        <mxCell id="Dmo2ccgEJF_z-c5CkqbE-13" value="代码：bsp/boards/board.c（dr16_rx_data_by_uart / dr16_forward_by_can / CMD_RC_DATA_FORWORD）&#xa;drv_dr16.c（UART 空闲中断内同时调用 rx 与 forward）" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;fontSize=11;fontColor=#666666" parent="1" vertex="1">
          <mxGeometry x="650" y="1090" width="600" height="40" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="H2JSnbJ-1No4ve-ixUeH" name="云台底盘协同">
    <mxGraphModel dx="2305" dy="416" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="09fs3A4uUtx3_xtPDr6U-1" value="RoboRTS-Firmware：云台 / 底盘固件分支与跨板协同&#xa;（含 GIMBAL_ADDRESS · MANIFOLD2_ADDRESS）" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontStyle=1;fontSize=18;spacingTop=8;spacingBottom=8;" parent="1" vertex="1">
          <mxGeometry x="250" y="1440" width="1920" height="56" as="geometry" />
        </mxCell>
        <mxCell id="09fs3A4uUtx3_xtPDr6U-2" value="A. 固件模式选择（同一工程，两块板各烧一份）" style="swimlane;horizontal=0;startSize=36;fontStyle=1;fontSize=14;fillColor=#DAE8FC;" parent="1" vertex="1">
          <mxGeometry x="250" y="1520" width="1920" height="260" as="geometry" />
        </mxCell>
        <mxCell id="09fs3A4uUtx3_xtPDr6U-3" value="① system_config()&#xa;&#xa;glb_sys_cfg = HAL_GPIO_ReadPin(APP_CONFIG)&#xa;典型引脚：PB13（见 CubeMX）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;fontSize=13;align=left;verticalAlign=top;spacingLeft=16;spacingTop=14;spacingBottom=12;" parent="09fs3A4uUtx3_xtPDr6U-2" vertex="1">
          <mxGeometry x="50" y="56" width="340" height="170" as="geometry" />
        </mxCell>
        <mxCell id="09fs3A4uUtx3_xtPDr6U-4" value="② task_init()&#xa;&#xa;if (get_sys_cfg() == CHASSIS_APP)&#xa;    chassis_app_init();&#xa;else&#xa;    gimbal_app_init();&#xa;&#xa;然后 app_protocol_init()：&#xa;local_addr、recv_cmd_table、route_table" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;fontSize=13;align=left;verticalAlign=top;spacingLeft=16;spacingTop=14;spacingBottom=12;" parent="09fs3A4uUtx3_xtPDr6U-2" vertex="1">
          <mxGeometry x="430" y="56" width="440" height="170" as="geometry" />
        </mxCell>
        <mxCell id="09fs3A4uUtx3_xtPDr6U-5" value="③ 底盘板（CHASSIS_APP = 1）&#xa;&#xa;local_addr = CHASSIS_ADDRESS (0x01)&#xa;chassis_task，CAN2 接底盘电机&#xa;协议收 CMD_PUSH_GIMBAL_INFO 等" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;fontSize=13;align=left;verticalAlign=top;spacingLeft=16;spacingTop=14;spacingBottom=12;" parent="09fs3A4uUtx3_xtPDr6U-2" vertex="1">
          <mxGeometry x="910" y="56" width="460" height="170" as="geometry" />
        </mxCell>
        <mxCell id="09fs3A4uUtx3_xtPDr6U-6" value="④ 云台板（else 分支）&#xa;&#xa;local_addr = GIMBAL_ADDRESS (0x02)&#xa;gimbal_task + shoot_task&#xa;CAN2 接云台电机反馈" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;fontSize=13;align=left;verticalAlign=top;spacingLeft=16;spacingTop=14;spacingBottom=12;" parent="09fs3A4uUtx3_xtPDr6U-2" vertex="1">
          <mxGeometry x="1410" y="56" width="460" height="170" as="geometry" />
        </mxCell>
        <mxCell id="09fs3A4uUtx3_xtPDr6U-7" style="endArrow=block;html=1;strokeWidth=2;fontSize=12;" parent="09fs3A4uUtx3_xtPDr6U-2" source="09fs3A4uUtx3_xtPDr6U-3" target="09fs3A4uUtx3_xtPDr6U-4" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="09fs3A4uUtx3_xtPDr6U-8" style="endArrow=block;html=1;strokeWidth=2;dashed=1;fontSize=12;" parent="09fs3A4uUtx3_xtPDr6U-2" source="09fs3A4uUtx3_xtPDr6U-4" target="09fs3A4uUtx3_xtPDr6U-5" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="09fs3A4uUtx3_xtPDr6U-9" style="endArrow=block;html=1;strokeWidth=2;dashed=1;fontSize=12;" parent="09fs3A4uUtx3_xtPDr6U-2" source="09fs3A4uUtx3_xtPDr6U-4" target="09fs3A4uUtx3_xtPDr6U-6" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="09fs3A4uUtx3_xtPDr6U-10" value="B. 协议层逻辑地址与路由（protocol_send(receiver, cmd, ...)）" style="swimlane;horizontal=0;startSize=36;fontStyle=1;fontSize=14;fillColor=#FFF2CC;" parent="1" vertex="1">
          <mxGeometry x="250" y="1810" width="1920" height="520" as="geometry" />
        </mxCell>
        <mxCell id="09fs3A4uUtx3_xtPDr6U-11" value="infantry_cmd.h 中的「收端逻辑地址」&#xa;&#xa;MANIFOLD2_ADDRESS = 0x00   — 上位机 / Manifold2&#xa;CHASSIS_ADDRESS   = 0x01   — 底盘 MCU&#xa;GIMBAL_ADDRESS    = 0x02   — 云台 MCU&#xa;&#xa;与 CAN 标准帧 ID 不同：GIMBAL_CAN_ID 0x500、CHASSIS_CAN_ID 0x600 由 protocol_can_interface_register 绑定到封装收发。&#xa;&#xa;protocol_set_route(地址, 接口名) 把逻辑地址映射到 usb 或某条 CAN 封装接口。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;fontSize=13;align=left;verticalAlign=top;spacingLeft=18;spacingTop=16;spacingBottom=16;spacingRight=14;" parent="09fs3A4uUtx3_xtPDr6U-10" vertex="1">
          <mxGeometry x="50" y="56" width="1820" height="200" as="geometry" />
        </mxCell>
        <mxCell id="09fs3A4uUtx3_xtPDr6U-12" value="云台板 gimbal_route_table[]&#xa;&#xa;GIMBAL_ADDRESS     → can1_0x600_to_0x500&#xa;MANIFOLD2_ADDRESS  → can1_0x600_to_0x500&#xa;&#xa;发往云台或上位机的单播，均从本板 CAN1 发出：&#xa;TX StdId = 0x600，对端期望 RX 0x500。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;fontSize=13;align=left;verticalAlign=top;spacingLeft=18;spacingTop=16;spacingBottom=16;spacingRight=14;" parent="09fs3A4uUtx3_xtPDr6U-10" vertex="1">
          <mxGeometry x="50" y="280" width="880" height="210" as="geometry" />
        </mxCell>
        <mxCell id="09fs3A4uUtx3_xtPDr6U-13" value="底盘板 chassis_route_table[]&#xa;&#xa;GIMBAL_ADDRESS     → can1_0x500_to_0x600&#xa;MANIFOLD2_ADDRESS  → usb&#xa;&#xa;发往云台：CAN1，本板 TX 0x500。&#xa;发往上位机：USB VCP。&#xa;&#xa;底盘 local_addr = CHASSIS_ADDRESS (0x01)。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;fontSize=13;align=left;verticalAlign=top;spacingLeft=18;spacingTop=16;spacingBottom=16;spacingRight=14;" parent="09fs3A4uUtx3_xtPDr6U-10" vertex="1">
          <mxGeometry x="990" y="280" width="880" height="210" as="geometry" />
        </mxCell>
        <mxCell id="09fs3A4uUtx3_xtPDr6U-14" value="C. 双 MCU 运行时数据流（随动 + 车体 yaw 回传云台）" style="swimlane;horizontal=0;startSize=36;fontStyle=1;fontSize=14;fillColor=#E6F3FF;" parent="1" vertex="1">
          <mxGeometry x="250" y="2370" width="1920" height="1520" as="geometry" />
        </mxCell>
        <mxCell id="09fs3A4uUtx3_xtPDr6U-15" value="云台 MCU — 周期上报云台状态&#xa;&#xa;SoftTimer 约 10ms：gimbal_info_push()&#xa;protocol_send(BROADCAST, CMD_PUSH_GIMBAL_INFO, ...)&#xa;经广播逻辑转发到 CAN1，底盘侧协议栈解包。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;fontSize=13;align=left;verticalAlign=top;spacingLeft=18;spacingTop=16;spacingBottom=16;" parent="09fs3A4uUtx3_xtPDr6U-14" vertex="1">
          <mxGeometry x="60" y="60" width="1800" height="130" as="geometry" />
        </mxCell>
        <mxCell id="09fs3A4uUtx3_xtPDr6U-16" value="云台 MCU — 遥控 / SDK&#xa;&#xa;gimbal_recv_cmd_table：&#xa;CMD_SET_GIMBAL_ANGLE 等&#xa;&#xa;上位机单播 receiver 为&#xa;GIMBAL 或 MANIFOLD2 时，&#xa;route 均指向同一条 CAN1。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;fontSize=13;align=left;verticalAlign=top;spacingLeft=18;spacingTop=14;spacingBottom=14;" parent="09fs3A4uUtx3_xtPDr6U-14" vertex="1">
          <mxGeometry x="60" y="220" width="560" height="220" as="geometry" />
        </mxCell>
        <mxCell id="09fs3A4uUtx3_xtPDr6U-17" value="CAN1 总线（双板互连）&#xa;&#xa;云台：TX 0x600 / RX 0x500&#xa;底盘：TX 0x500 / RX 0x600&#xa;&#xa;应用层协议帧封装在 CAN 数据域中。" style="shape=cylinder;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=16;fillColor=#DAE8FC;fontSize=13;align=center;verticalAlign=middle;spacingTop=12;spacingBottom=12;" parent="09fs3A4uUtx3_xtPDr6U-14" vertex="1">
          <mxGeometry x="700" y="225" width="280" height="210" as="geometry" />
        </mxCell>
        <mxCell id="09fs3A4uUtx3_xtPDr6U-18" value="云台 MCU — 接收底盘车体 yaw（非 protocol）&#xa;&#xa;CAN1 → gimbal_gyro_yaw_update()&#xa;StdId = 0x401（chassis_angle_broadcast）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;fontSize=13;align=left;verticalAlign=top;spacingLeft=18;spacingTop=14;spacingBottom=14;" parent="09fs3A4uUtx3_xtPDr6U-14" vertex="1">
          <mxGeometry x="1040" y="220" width="820" height="220" as="geometry" />
        </mxCell>
        <mxCell id="09fs3A4uUtx3_xtPDr6U-19" value="底盘 MCU — 解析云台信息（随动）&#xa;&#xa;chassis_recv_cmd_table：CMD_PUSH_GIMBAL_INFO → follow_angle_info_rcv()&#xa;更新 follow_relative_angle（云台相对机身 yaw，单位来自 cmd 缩放）。&#xa;RC S2 UP：pid_follow 用该角算 wz，车身转向跟随云台指向。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;fontSize=13;align=left;verticalAlign=top;spacingLeft=18;spacingTop=16;spacingBottom=16;" parent="09fs3A4uUtx3_xtPDr6U-14" vertex="1">
          <mxGeometry x="60" y="480" width="1800" height="170" as="geometry" />
        </mxCell>
        <mxCell id="09fs3A4uUtx3_xtPDr6U-20" value="底盘 MCU — SDK 速度 / 上位机数据&#xa;&#xa;RC S2 DOWN：使能 SDK 与相关离线检测。&#xa;CMD_SET_CHASSIS_SPEED / CMD_SET_CHASSIS_SPD_ACC 经协议进入底盘（常见拓扑：上位机 USB 接底盘 → MANIFOLD2_ADDRESS → usb）。&#xa;chassis_info_push：protocol_send(MANIFOLD2_ADDRESS, CMD_PUSH_CHASSIS_INFO, ...)。&#xa;referee_data_send2pc：protocol_send(MANIFOLD2_ADDRESS, cmd_id + 0x4000, ...)。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;fontSize=13;align=left;verticalAlign=top;spacingLeft=18;spacingTop=16;spacingBottom=16;" parent="09fs3A4uUtx3_xtPDr6U-14" vertex="1">
          <mxGeometry x="60" y="690" width="1800" height="210" as="geometry" />
        </mxCell>
        <mxCell id="09fs3A4uUtx3_xtPDr6U-21" value="底盘 MCU — 车体 yaw 广播给云台&#xa;&#xa;SoftTimer：chassis_angle_broadcast()&#xa;can1_std_transmit(0x401, yaw, yaw_rate 打包)，供云台 gyro 支路融合。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;fontSize=13;align=left;verticalAlign=top;spacingLeft=18;spacingTop=16;spacingBottom=16;" parent="09fs3A4uUtx3_xtPDr6U-14" vertex="1">
          <mxGeometry x="60" y="940" width="1800" height="130" as="geometry" />
        </mxCell>
        <mxCell id="09fs3A4uUtx3_xtPDr6U-22" value="上位机（逻辑地址 MANIFOLD2_ADDRESS = 0x00）&#xa;&#xa;典型接线：USB 接底盘板，由 chassis_route_table 将 0x00 映射到 usb。&#xa;若 USB 仅接云台板且需直连下发底盘指令，须在云台 route 中增加 CHASSIS_ADDRESS → CAN 转发（当前 gimbal_route_table 未配置）。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;fontSize=13;align=left;verticalAlign=top;spacingLeft=18;spacingTop=16;spacingBottom=16;" parent="09fs3A4uUtx3_xtPDr6U-14" vertex="1">
          <mxGeometry x="60" y="1110" width="1800" height="150" as="geometry" />
        </mxCell>
        <mxCell id="09fs3A4uUtx3_xtPDr6U-23" value="CMD_PUSH_GIMBAL_INFO&#xa;（广播）" style="endArrow=block;html=1;strokeWidth=2;fontSize=12;" parent="09fs3A4uUtx3_xtPDr6U-14" source="09fs3A4uUtx3_xtPDr6U-15" target="09fs3A4uUtx3_xtPDr6U-17" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="09fs3A4uUtx3_xtPDr6U-24" style="endArrow=block;html=1;strokeWidth=2;" parent="09fs3A4uUtx3_xtPDr6U-14" source="09fs3A4uUtx3_xtPDr6U-17" target="09fs3A4uUtx3_xtPDr6U-19" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="09fs3A4uUtx3_xtPDr6U-25" value="usb" style="endArrow=block;html=1;strokeWidth=2;fontSize=12;" parent="09fs3A4uUtx3_xtPDr6U-14" source="09fs3A4uUtx3_xtPDr6U-20" target="09fs3A4uUtx3_xtPDr6U-22" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="09fs3A4uUtx3_xtPDr6U-26" value="说明：底盘发出 0x401 为 cC3 → CAN 物理帧，图中未再画一条指向圆柱的箭头，以免与「广播云台信息」竖线混淆；右栏 cG3 已标明接收端。" style="text;html=1;strokeColor=none;fillColor=#FFFFCC;align=left;fontSize=12;rounded=1;spacingLeft=14;spacingTop=10;spacingBottom=10;spacingRight=10;" parent="09fs3A4uUtx3_xtPDr6U-14" vertex="1">
          <mxGeometry x="60" y="1300" width="1800" height="56" as="geometry" />
        </mxCell>
        <mxCell id="09fs3A4uUtx3_xtPDr6U-27" value="源码索引：application/init.c · infantry_cmd.h · gimbal_app.c / chassis_app.c（route_table、CAN 注册）· gimbal_cmd.c（gimbal_info_push）· chassis_task.c（follow_angle_info_rcv、chassis_angle_broadcast）· components/protocol/protocol.c" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=12;fontColor=#666666;spacingTop=6;" parent="1" vertex="1">
          <mxGeometry x="250" y="3900" width="1920" height="56" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="Cb7M1S6Mk2vpts5a_lvg" name="标定">
    <mxGraphModel dx="2305" dy="1243" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="aHkwVrM_fYGuNG8t61xn-1" value="RoboRTS-Firmware：底盘 / 云台标定方法 · 流程 · 存储方式 · 默认值" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontStyle=1;fontSize=18;spacingTop=8;spacingBottom=8;" parent="1" vertex="1">
          <mxGeometry x="290" y="350" width="1680" height="55" as="geometry" />
        </mxCell>
        <mxCell id="aHkwVrM_fYGuNG8t61xn-2" value="项目实际只有两类持久化标定：① 云台编码器零位（GIMBAL_PARAM_KEY=&quot;ECD_CENTER&quot;，仅 4 字节）②BMI088 陀螺仪零偏（BMI088_PARAM_KEY=&quot;BMI088_PARAM&quot;，12 字节 fp32×3）。&#xa;底盘没有专用持久化标定流程：电机编码器初值由 motor.c 在前 50 帧 CAN 中自动取一次作为 offset_ecd（每次上电），其它几何/电机参数（轮距、轴距、偏置、减速比等）全部为编译期宏。&#xa;两个 KEY 均通过 EasyFlash 存放在 STM32F4 内部 Flash 的备份区（EF_START_ADDR = FLASH_BASE + 768KB，ENV_AREA_SIZE = 256KB），写入后立即 NVIC_SystemReset 触发重新加载。" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=18;spacingTop=12;fillColor=#FFF4CC;strokeColor=#D6B656;fontSize=12;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="290" y="420" width="1680" height="160" as="geometry" />
        </mxCell>
        <mxCell id="aHkwVrM_fYGuNG8t61xn-3" value="① 存储层 — EasyFlash NG 模式（STM32F4 片内 Flash）" style="swimlane;horizontal=0;startSize=34;fontSize=13;fillColor=#E1D5E7;strokeColor=#9673A6;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="290" y="600" width="1680" height="320" as="geometry" />
        </mxCell>
        <mxCell id="aHkwVrM_fYGuNG8t61xn-4" value="components/easyflash/inc/ef_cfg.h&#xa;&#xa;EF_USING_ENV&#xa;EF_ERASE_MIN_SIZE = 128 KB&#xa;EF_WRITE_GRAN     = 8 bit&#xa;EF_START_ADDR     = FLASH_BASE + (512+256) KB&#xa;                  = 0x080C0000（Sector 9 起）&#xa;ENV_AREA_SIZE     = 2 × 128 KB = 256 KB&#xa;LOG_AREA_SIZE     = 未启用" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;fontSize=12;align=left;spacingLeft=14;spacingTop=10;verticalAlign=top;" parent="aHkwVrM_fYGuNG8t61xn-3" vertex="1">
          <mxGeometry x="40" y="55" width="380" height="220" as="geometry" />
        </mxCell>
        <mxCell id="aHkwVrM_fYGuNG8t61xn-5" value="Flash 备份区映射（STM32F407IG）&#xa;&#xa;┌───────────────────────────────┐&#xa;│ 0x0800_0000  应用程序代码区    │&#xa;├───────────────────────────────┤&#xa;│ 0x080C_0000  ENV_AREA  (256K) │ ← Sector 9 + 10&#xa;│   key=&quot;boot_times&quot;            │&#xa;│   key=&quot;ECD_CENTER&quot;            │&#xa;│   key=&quot;BMI088_PARAM&quot;          │&#xa;├───────────────────────────────┤&#xa;│  …  其余扇区                  │&#xa;└───────────────────────────────┘" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;fontSize=12;fontFamily=Courier New;align=left;spacingLeft=14;spacingTop=10;verticalAlign=top;" parent="aHkwVrM_fYGuNG8t61xn-3" vertex="1">
          <mxGeometry x="450" y="55" width="500" height="220" as="geometry" />
        </mxCell>
        <mxCell id="aHkwVrM_fYGuNG8t61xn-6" value="读 / 写 / 删 API（components/easyflash/src/ef_env.c）&#xa;&#xa;ef_get_env_blob(key, &amp;buf, len, &amp;saved_len)&#xa;ef_set_env_blob(key, &amp;buf, len)&#xa;ef_del_env(key)&#xa;&#xa;并发：&#xa;ef_port_env_lock / unlock 关 / 开 IRQ&#xa;&#xa;默认 ENV（ef_port.c）：&#xa;  static ef_env default_env_set[] = { {&quot;boot_times&quot;, &quot;0&quot;} };" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;fontSize=12;align=left;spacingLeft=14;spacingTop=10;verticalAlign=top;" parent="aHkwVrM_fYGuNG8t61xn-3" vertex="1">
          <mxGeometry x="980" y="55" width="660" height="220" as="geometry" />
        </mxCell>
        <mxCell id="aHkwVrM_fYGuNG8t61xn-7" value="② BMI088 陀螺仪零偏标定（绑定温度 40°C） — 由 sensor_task / drv_bmi088.c 实现" style="swimlane;horizontal=0;startSize=34;fontSize=13;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="290" y="940" width="1680" height="500" as="geometry" />
        </mxCell>
        <mxCell id="aHkwVrM_fYGuNG8t61xn-8" value="触发条件&#xa;&#xa;sensor_task → bmi088_get_offset()&#xa;&#xa;读 BMI088_PARAM_KEY：&#xa;  read_len == sizeof(gyro_offset)?&#xa;  · 是 → 直接使用持久化值&#xa;  · 否 → 调用 bmi088_set_offset()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;fontSize=12;align=left;spacingLeft=14;spacingTop=10;verticalAlign=top;" parent="aHkwVrM_fYGuNG8t61xn-7" vertex="1">
          <mxGeometry x="40" y="55" width="360" height="190" as="geometry" />
        </mxCell>
        <mxCell id="aHkwVrM_fYGuNG8t61xn-9" value="阶段 1 — 等待恒温&#xa;&#xa;imu_temp_ctrl_init()  开启 PID 加热&#xa;DEFAULT_IMU_TEMP = 40.0f °C&#xa;while ( |40 - temp| &gt; 1.0 ) {&#xa;   BMI088_Read; imu_temp_keep;&#xa;   HAL_Delay(2);&#xa;   LED_R/B/G 全亮 (校准指示)&#xa;}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;fontSize=12;align=left;spacingLeft=14;spacingTop=10;verticalAlign=top;" parent="aHkwVrM_fYGuNG8t61xn-7" vertex="1">
          <mxGeometry x="430" y="55" width="380" height="190" as="geometry" />
        </mxCell>
        <mxCell id="aHkwVrM_fYGuNG8t61xn-10" value="阶段 2 — 静止采样取均值&#xa;&#xa;for (i=0; i&lt;300; i++) {&#xa;   BMI088_Read(gyro, accel, &amp;temperate);&#xa;   gyro_offset[0..2] += gyro[0..2];&#xa;   imu_temp_keep; HAL_Delay(2);&#xa;}&#xa;gyro_offset[i] /= 300;&#xa;&#xa;采样总耗时 ≈ 600 ms（机器须保持完全静止）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;fontSize=12;align=left;spacingLeft=14;spacingTop=10;verticalAlign=top;" parent="aHkwVrM_fYGuNG8t61xn-7" vertex="1">
          <mxGeometry x="840" y="55" width="380" height="190" as="geometry" />
        </mxCell>
        <mxCell id="aHkwVrM_fYGuNG8t61xn-11" value="阶段 3 — 持久化 + 复位&#xa;&#xa;ef_set_env_blob(&#xa;  BMI088_PARAM_KEY,  // &quot;BMI088_PARAM&quot;&#xa;  gyro_offset, sizeof(gyro_offset));&#xa;__disable_irq();&#xa;NVIC_SystemReset();&#xa;&#xa;复位后 sensor_task 重新执行&#xa;bmi088_get_offset() 即命中 EasyFlash" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;fontSize=12;align=left;spacingLeft=14;spacingTop=10;verticalAlign=top;" parent="aHkwVrM_fYGuNG8t61xn-7" vertex="1">
          <mxGeometry x="1250" y="55" width="390" height="190" as="geometry" />
        </mxCell>
        <mxCell id="aHkwVrM_fYGuNG8t61xn-12" value="数据结构与运行时使用（drv_bmi088.c）&#xa;&#xa;fp32 gyro_offset[3];           // 仅陀螺零偏被持久化&#xa;fp32 accel_offset[3] = {0};    // 加速度计零偏：未做标定，恒为 0&#xa;&#xa;bmi088_cali_slove(): gyro[i] = Σ R[i][j]*raw_gyro[j] - gyro_offset[i];&#xa;BMI088_BOARD_INSTALL_SPIN_MATRIX = {{0,1,0},{-1,0,0},{0,0,1}}  // 板载安装姿态" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F0F0;fontSize=12;align=left;spacingLeft=14;spacingTop=10;verticalAlign=top;" parent="aHkwVrM_fYGuNG8t61xn-7" vertex="1">
          <mxGeometry x="40" y="265" width="780" height="180" as="geometry" />
        </mxCell>
        <mxCell id="aHkwVrM_fYGuNG8t61xn-13" value="重新标定的方式&#xa;&#xa;1) 上电后 EasyFlash 中没有 BMI088_PARAM_KEY（首次 / 清空后）&#xa;2) chassis_user_key_handle / gimbal_user_key_handle：&#xa;     按板载 USER 键（GPIO PIN_0 EXTI）&#xa;     → ef_del_env(BMI088_PARAM_KEY) → 复位 → 再校&#xa;3) 上位机指令 CMD_GIMBAL_ADJUST (0x0403)&#xa;     gimbal_adjust_cmd → gimbal_user_key_handle&#xa;     （注意：会同时删除 GIMBAL_PARAM_KEY）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F0F0;fontSize=12;align=left;spacingLeft=14;spacingTop=10;verticalAlign=top;" parent="aHkwVrM_fYGuNG8t61xn-7" vertex="1">
          <mxGeometry x="840" y="265" width="800" height="180" as="geometry" />
        </mxCell>
        <mxCell id="aHkwVrM_fYGuNG8t61xn-14" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;" parent="aHkwVrM_fYGuNG8t61xn-7" source="aHkwVrM_fYGuNG8t61xn-8" target="aHkwVrM_fYGuNG8t61xn-9" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="aHkwVrM_fYGuNG8t61xn-15" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;" parent="aHkwVrM_fYGuNG8t61xn-7" source="aHkwVrM_fYGuNG8t61xn-9" target="aHkwVrM_fYGuNG8t61xn-10" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="aHkwVrM_fYGuNG8t61xn-16" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;" parent="aHkwVrM_fYGuNG8t61xn-7" source="aHkwVrM_fYGuNG8t61xn-10" target="aHkwVrM_fYGuNG8t61xn-11" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="aHkwVrM_fYGuNG8t61xn-17" value="③ 云台编码器中心（YAW/PITCH ECD CENTER）— 机械咬合法 — 由 gimbal_task / gimbal_center_adjust 实现" style="swimlane;horizontal=0;startSize=34;fontSize=13;fillColor=#D5E8D4;strokeColor=#82B366;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="290" y="1460" width="1680" height="600" as="geometry" />
        </mxCell>
        <mxCell id="aHkwVrM_fYGuNG8t61xn-18" value="触发条件 / 入口（gimbal_task）&#xa;&#xa;ef_get_env_blob(GIMBAL_PARAM_KEY, &amp;center_param, ...);&#xa;&#xa;若 read_len ≠ sizeof(center_param)：&#xa;  → gimbal_set_work_mode(ADJUST_MODE)&#xa;否则：&#xa;  → gimbal_set_offset(yaw_ecd, pitch_ecd)&#xa;  → gimbal_init_start() 进入 INIT_MODE 回中" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;fontSize=12;align=left;spacingLeft=14;spacingTop=10;verticalAlign=top;" parent="aHkwVrM_fYGuNG8t61xn-17" vertex="1">
          <mxGeometry x="40" y="55" width="450" height="200" as="geometry" />
        </mxCell>
        <mxCell id="aHkwVrM_fYGuNG8t61xn-19" value="ADJUST_MODE — Pitch 标定（约 4 s）&#xa;&#xa;p_motor = &amp;p_gimbal-&gt;pitch_motor;&#xa;t = get_time_ms();&#xa;while ( now - t &lt;= 2000 ) {&#xa;   motor_set_current(p_motor, +8000);&#xa;   pit_ecd_l = ecd; HAL_Delay(2);&#xa;}&#xa;t = HAL_GetTick();&#xa;while ( now - t &lt;= 2000 ) {&#xa;   motor_set_current(p_motor, -8000);&#xa;   pit_ecd_r = ecd; HAL_Delay(2);&#xa;}&#xa;// 取均值；若跨越 ±4096 边界则 ±4096 修正" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;fontSize=12;align=left;spacingLeft=14;spacingTop=10;verticalAlign=top;" parent="aHkwVrM_fYGuNG8t61xn-17" vertex="1">
          <mxGeometry x="520" y="55" width="380" height="270" as="geometry" />
        </mxCell>
        <mxCell id="aHkwVrM_fYGuNG8t61xn-20" value="ADJUST_MODE — Yaw 标定（约 6 s）&#xa;&#xa;p_motor = &amp;p_gimbal-&gt;yaw_motor;&#xa;t = get_time_ms();&#xa;while ( now - t &lt;= 3000 ) {&#xa;   motor_set_current(p_motor, +6000);&#xa;   yaw_ecd_l = ecd; HAL_Delay(2);&#xa;}&#xa;t = HAL_GetTick();&#xa;while ( now - t &lt;= 3000 ) {&#xa;   motor_set_current(p_motor, -6000);&#xa;   yaw_ecd_r = ecd; HAL_Delay(2);&#xa;}&#xa;// 同样取均值，含 ±4096 跨界处理" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;fontSize=12;align=left;spacingLeft=14;spacingTop=10;verticalAlign=top;" parent="aHkwVrM_fYGuNG8t61xn-17" vertex="1">
          <mxGeometry x="930" y="55" width="380" height="270" as="geometry" />
        </mxCell>
        <mxCell id="aHkwVrM_fYGuNG8t61xn-21" value="持久化 + 复位&#xa;&#xa;ef_set_env_blob(&#xa;  GIMBAL_PARAM_KEY,   // &quot;ECD_CENTER&quot;&#xa;  &amp;center_param,&#xa;  sizeof(center_param));&#xa;&#xa;struct gimbal_param {&#xa;  uint16_t pitch_ecd_center;&#xa;  uint16_t yaw_ecd_center;&#xa;};  // 共 4 字节&#xa;&#xa;__disable_irq();&#xa;NVIC_SystemReset();&#xa;while(1);" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;fontSize=12;align=left;spacingLeft=14;spacingTop=10;verticalAlign=top;fontFamily=Courier New;" parent="aHkwVrM_fYGuNG8t61xn-17" vertex="1">
          <mxGeometry x="1340" y="55" width="300" height="270" as="geometry" />
        </mxCell>
        <mxCell id="aHkwVrM_fYGuNG8t61xn-22" value="复位后：INIT_MODE 回中（gimbal_init_handle）&#xa;&#xa;ramp_v0_init(&amp;pitch_ramp, BACK_CENTER_TIME / GIMBAL_PERIOD = 600);&#xa;ramp_v0_init(&amp;yaw_ramp,   600);&#xa;&#xa;循环：&#xa;  gimbal_set_pitch_mode = ENCODER_MODE; yaw 同；&#xa;  set_pitch_angle = ecd_pitch * (1 - ramp(pitch_ramp));&#xa;  if (|ecd_pitch| &lt; 2.0) gimbal_yaw_enable;&#xa;       set_yaw_angle = ecd_yaw * (1 - ramp(yaw_ramp));&#xa;  if (|ecd_yaw| &lt; 1.2) → gimbal_set_work_mode(NORMAL_MODE);" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F0F0;fontSize=12;align=left;spacingLeft=14;spacingTop=10;verticalAlign=top;" parent="aHkwVrM_fYGuNG8t61xn-17" vertex="1">
          <mxGeometry x="40" y="350" width="900" height="200" as="geometry" />
        </mxCell>
        <mxCell id="aHkwVrM_fYGuNG8t61xn-23" value="运行时使用（components/modules/gimbal.c）&#xa;&#xa;ENCODER_ANGLE_RATIO = 8192/360°&#xa;&#xa;ecd_angle.yaw   = sign · gimbal_get_ecd_angle(raw_ecd, yaw_ecd_center)   / ratio&#xa;ecd_angle.pitch = sign · gimbal_get_ecd_angle(raw_ecd, pitch_ecd_center) / ratio&#xa;&#xa;ANGLE 限制：&#xa;  PITCH_ANGLE_MIN/MAX = ±20°&#xa;  YAW_ANGLE_MIN/MAX   = ±70°" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F0F0;fontSize=12;align=left;spacingLeft=14;spacingTop=10;verticalAlign=top;" parent="aHkwVrM_fYGuNG8t61xn-17" vertex="1">
          <mxGeometry x="970" y="350" width="670" height="200" as="geometry" />
        </mxCell>
        <mxCell id="aHkwVrM_fYGuNG8t61xn-24" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;" parent="aHkwVrM_fYGuNG8t61xn-17" source="aHkwVrM_fYGuNG8t61xn-18" target="aHkwVrM_fYGuNG8t61xn-19" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="aHkwVrM_fYGuNG8t61xn-25" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;" parent="aHkwVrM_fYGuNG8t61xn-17" source="aHkwVrM_fYGuNG8t61xn-19" target="aHkwVrM_fYGuNG8t61xn-20" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="aHkwVrM_fYGuNG8t61xn-26" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;" parent="aHkwVrM_fYGuNG8t61xn-17" source="aHkwVrM_fYGuNG8t61xn-20" target="aHkwVrM_fYGuNG8t61xn-21" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="aHkwVrM_fYGuNG8t61xn-27" value="④ 底盘标定 — 没有持久化标定，仅有上电编码器零位 + 编译期常量" style="swimlane;horizontal=0;startSize=34;fontSize=13;fillColor=#FFE6CC;strokeColor=#D79B00;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="290" y="2080" width="1680" height="370" as="geometry" />
        </mxCell>
        <mxCell id="aHkwVrM_fYGuNG8t61xn-28" value="电机编码器零位（每次上电自动取一次，不入 Flash）&#xa;&#xa;chassis_pid_init() 把 4 个轮子 motor[i].init_offset_f = 1&#xa;motor.c::get_encoder_data() 收到第一帧时调用 get_motor_offset()：&#xa;   ptr-&gt;ecd        = (rx[0]&lt;&lt;8 | rx[1]);&#xa;   ptr-&gt;offset_ecd = ptr-&gt;ecd;     // 作为基准&#xa;之后每帧：total_ecd = round_cnt × 8192 + ecd - offset_ecd;&#xa;msg_cnt &gt; 50 时 init_offset_f = 0 不再覆写。&#xa;&#xa;⇒ 不持久化；每次上电由「上电瞬间编码器读数」决定，作里程计零点。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;fontSize=12;align=left;spacingLeft=14;spacingTop=10;verticalAlign=top;" parent="aHkwVrM_fYGuNG8t61xn-27" vertex="1">
          <mxGeometry x="40" y="55" width="780" height="290" as="geometry" />
        </mxCell>
        <mxCell id="aHkwVrM_fYGuNG8t61xn-29" value="电机 CAN ID 自动分配（运维操作，不是「标定」）&#xa;&#xa;chassis_task: RC_S2_DOWN 且 ch1&lt;-400, ch2&lt;-400, ch3&gt;400, ch4&lt;-400 持续 ~2s&#xa;→ motor_auto_set_id(DEVICE_CAN2)&#xa;→ 发送 0x700 广播帧，由电调进入 ID 分配模式" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;fontSize=12;align=left;spacingLeft=14;spacingTop=10;verticalAlign=top;" parent="aHkwVrM_fYGuNG8t61xn-27" vertex="1">
          <mxGeometry x="840" y="55" width="800" height="120" as="geometry" />
        </mxCell>
        <mxCell id="aHkwVrM_fYGuNG8t61xn-30" value="结构 / 几何参数（编译期，无运行时标定）&#xa;&#xa;详见右侧 ⑤ 默认值表 — 来自 components/algorithm/mecanum.h，&#xa;包含轮周长、轴距、轮距、云台-底盘旋转中心偏置 (ROTATE_X/Y_OFFSET)、电机减速比、最大速度等。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;fontSize=12;align=left;spacingLeft=14;spacingTop=10;verticalAlign=top;" parent="aHkwVrM_fYGuNG8t61xn-27" vertex="1">
          <mxGeometry x="840" y="195" width="800" height="150" as="geometry" />
        </mxCell>
        <mxCell id="aHkwVrM_fYGuNG8t61xn-31" value="⑤ 默认值与编译期常量（无标定时即生效）" style="swimlane;horizontal=0;startSize=34;fontSize=13;fillColor=#F8CECC;strokeColor=#B85450;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="290" y="2470" width="1680" height="240" as="geometry" />
        </mxCell>
        <mxCell id="aHkwVrM_fYGuNG8t61xn-32" value="IMU / AHRS （drv_io.h, drv_bmi088.c）&#xa;&#xa;DEFAULT_IMU_TEMP = 40.0f °C&#xa;gyro_offset[3]  = {0,0,0}（未标定时）&#xa;accel_offset[3] = {0,0,0}（始终为 0，无标定）&#xa;BMI088 安装矩阵：{{0,1,0},{-1,0,0},{0,0,1}}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;fontSize=12;align=left;spacingLeft=14;spacingTop=10;verticalAlign=top;" parent="aHkwVrM_fYGuNG8t61xn-31" vertex="1">
          <mxGeometry x="40" y="55" width="500" height="170" as="geometry" />
        </mxCell>
        <mxCell id="aHkwVrM_fYGuNG8t61xn-33" value="云台 （gimbal.h, gimbal_task.c）&#xa;&#xa;PITCH_ANGLE_MIN/MAX = ±20°&#xa;YAW_ANGLE_MIN/MAX   = ±70°&#xa;ENCODER_ANGLE_RATIO = 8192/360°&#xa;PITCH_MOTOR_POSITIVE_DIR = -1.0f, YAW_= +1.0f&#xa;BACK_CENTER_TIME = 3000 ms（INIT 回中 ramp）&#xa;无标定时：进入 ADJUST_MODE 自动学习中心" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;fontSize=12;align=left;spacingLeft=14;spacingTop=10;verticalAlign=top;" parent="aHkwVrM_fYGuNG8t61xn-31" vertex="1">
          <mxGeometry x="560" y="55" width="500" height="170" as="geometry" />
        </mxCell>
        <mxCell id="aHkwVrM_fYGuNG8t61xn-34" value="底盘 （components/algorithm/mecanum.h）&#xa;&#xa;PERIMETER = 478 mm  RADIUS = 76 mm&#xa;Standard：WHEELTRACK 400 / WHEELBASE 376（mm）&#xa;ICRA2019 ：WHEELTRACK 394 / WHEELBASE 415（mm）&#xa;ROTATE_X_OFFSET = 7 mm   ROTATE_Y_OFFSET = 0 mm&#xa;MOTOR_DECELE_RATIO = 1/19   MAX_WHEEL_RPM = 8500&#xa;MAX_CHASSIS_VX/VY = 3300 mm/s   MAX_VW = 300 °/s" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;fontSize=12;align=left;spacingLeft=14;spacingTop=10;verticalAlign=top;" parent="aHkwVrM_fYGuNG8t61xn-31" vertex="1">
          <mxGeometry x="1080" y="55" width="560" height="170" as="geometry" />
        </mxCell>
        <mxCell id="aHkwVrM_fYGuNG8t61xn-35" value="代码索引：application/sensor_task.c · bsp/boards/drv_bmi088.c · bsp/boards/drv_imu.h（BMI088_PARAM_KEY）· application/gimbal/gimbal_task.{c,h}（GIMBAL_PARAM_KEY、ADJUST/INIT/NORMAL）· application/gimbal/gimbal_app.c（USER 键、CMD_GIMBAL_ADJUST）· application/gimbal/gimbal_cmd.c（gimbal_adjust_cmd）· components/modules/gimbal.c（gimbal_set_offset、gimbal_get_ecd_angle）· components/modules/chassis.c（init_offset_f）· components/devices/motor.c（get_motor_offset）· components/algorithm/mecanum.h（几何 / 速度上限）· components/easyflash/{inc/ef_cfg.h, port/ef_port.c, src/ef_env.c}" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=11;fontColor=#666666;spacingTop=8;" parent="1" vertex="1">
          <mxGeometry x="290" y="2730" width="1680" height="60" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="6rAWQKrKoTgLCiKXXUbs" name="底盘速度控制链路">
    <mxGraphModel dx="2066" dy="1243" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="940R0j_qNuveTOPMAYgD-1" value="底盘速度控制链路（chassis_task · chassis_cmd · mecanum · chassis）" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontStyle=1;fontSize=20;spacingTop=8;spacingBottom=8;" parent="1" vertex="1">
          <mxGeometry x="320" y="60" width="1820" height="44" as="geometry" />
        </mxCell>
        <mxCell id="940R0j_qNuveTOPMAYgD-2" value="① 期望车体速度 vx, vy, vw（谁写入）" style="swimlane;horizontal=0;startSize=36;fontStyle=1;fontSize=14;fillColor=#DAE8FC;strokeColor=#6C8EBF;" parent="1" vertex="1">
          <mxGeometry x="320" y="120" width="1820" height="420" as="geometry" />
        </mxCell>
        <mxCell id="940R0j_qNuveTOPMAYgD-3" value="遥控器分支&#xa;application/chassis/chassis_task.c&#xa;&#xa;周期 ≈ 5 ms（osDelay(5)）&#xa;&#xa;· RC_S2_UP（随动）&#xa;  vx = ch2/660·MAX_CHASSIS_VX_SPEED&#xa;  vy = −ch1/660·MAX_CHASSIS_VY_SPEED&#xa;  wz = −pid_follow(follow_relative_angle)&#xa;  chassis_set_offset(ROTATE_X/Y_OFFSET)&#xa;&#xa;· RC_S2_MID（全手动）&#xa;  vx, vy 同上；wz = −ch3/660·MAX_CHASSIS_VW_SPEED&#xa;  offset 置 0&#xa;&#xa;· RC 过渡档：chassis_set_speed(0,0,0)&#xa;&#xa;均调用：chassis_set_acc(0,0,0)&#xa;      chassis_set_speed(vx, vy, wz)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;fontSize=12;align=left;verticalAlign=top;spacingLeft=16;spacingTop=14;spacingBottom=12;" parent="940R0j_qNuveTOPMAYgD-2" vertex="1">
          <mxGeometry x="50" y="60" width="860" height="330" as="geometry" />
        </mxCell>
        <mxCell id="940R0j_qNuveTOPMAYgD-4" value="上位机 / SDK 分支&#xa;application/chassis/chassis_cmd.c&#xa;&#xa;前提：RC_S2_DOWN 且 get_chassis_sdk_mode()==ON&#xa;&#xa;· chassis_speed_ctrl — CMD_SET_CHASSIS_SPEED&#xa;  set_offset(rotate_x/y)&#xa;  set_acc(0,0,0)&#xa;  set_speed(vx, vy, vw/10)  ← 协议 vw 缩放&#xa;&#xa;· chassis_spd_acc_ctrl — CMD_SET_CHASSIS_SPD_ACC&#xa;  set_offset(...)&#xa;  set_acc(ax, ay, wz/10)&#xa;  set_speed(vx, vy, vw/10)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;fontSize=12;align=left;verticalAlign=top;spacingLeft=16;spacingTop=14;spacingBottom=12;" parent="940R0j_qNuveTOPMAYgD-2" vertex="1">
          <mxGeometry x="940" y="60" width="830" height="330" as="geometry" />
        </mxCell>
        <mxCell id="940R0j_qNuveTOPMAYgD-5" value="② 写入底盘对象（components/modules/chassis.c）" style="swimlane;horizontal=0;startSize=36;fontStyle=1;fontSize=14;fillColor=#E1D5E7;strokeColor=#9673A6;" parent="1" vertex="1">
          <mxGeometry x="320" y="570" width="1820" height="200" as="geometry" />
        </mxCell>
        <mxCell id="940R0j_qNuveTOPMAYgD-6" value="chassis_set_speed(chassis, vx, vy, vw)&#xa;→ chassis-&gt;mecanum.speed.{vx, vy, vw}&#xa;&#xa;chassis_set_acc(ax, ay, wz) → chassis-&gt;acc&#xa;（在下一步 PID 周期内可按 dt 积分进 speed）&#xa;&#xa;chassis_set_offset(x, y) → mecanum.param.rotate_*&#xa;（影响麦克纳姆绕偏置旋转中心的四轮分配）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;fontSize=12;align=left;verticalAlign=top;spacingLeft=16;spacingTop=14;spacingBottom=12;" parent="940R0j_qNuveTOPMAYgD-5" vertex="1">
          <mxGeometry x="50" y="56" width="1720" height="120" as="geometry" />
        </mxCell>
        <mxCell id="940R0j_qNuveTOPMAYgD-7" value="③ 软定时 5 ms：chassis_pid_calculate（chassis.c）" style="swimlane;horizontal=0;startSize=36;fontStyle=1;fontSize=14;fillColor=#FFE6CC;strokeColor=#D79B00;" parent="1" vertex="1">
          <mxGeometry x="320" y="800" width="1820" height="520" as="geometry" />
        </mxCell>
        <mxCell id="940R0j_qNuveTOPMAYgD-8" value="1）加速度积分（可选）&#xa;&#xa;speed.vx += acc.ax/1000·Δt&#xa;speed.vy += acc.ay/1000·Δt&#xa;speed.vw += acc.wz/1000·Δt&#xa;&#xa;遥控 S2 UP/MID 通常 acc=0，此项不变。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;fontSize=12;align=left;verticalAlign=top;spacingLeft=14;spacingTop=12;" parent="940R0j_qNuveTOPMAYgD-7" vertex="1">
          <mxGeometry x="50" y="56" width="540" height="160" as="geometry" />
        </mxCell>
        <mxCell id="940R0j_qNuveTOPMAYgD-9" value="2）mecanum_calculate（mecanum.c）&#xa;&#xa;输入：mecanum.speed + param（来自 mecanum.h）&#xa;&#xa;· MEC_VAL_LIMIT：|vx|≤MAX_CHASSIS_VX 等&#xa;· 逆运动学：vx,vy,vw(mm/s,°/s) → wheel_rpm[0..3]&#xa;  几何：WHEELBASE、WHEELTRACK、ROTATE_*、&#xa;  PERIMETER、MOTOR_DECELE_RATIO&#xa;· 若 max|wheel_rpm| &gt; MAX_WHEEL_RPM：四轮同比缩放" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;fontSize=12;align=left;verticalAlign=top;spacingLeft=14;spacingTop=12;" parent="940R0j_qNuveTOPMAYgD-7" vertex="1">
          <mxGeometry x="620" y="56" width="600" height="200" as="geometry" />
        </mxCell>
        <mxCell id="940R0j_qNuveTOPMAYgD-10" value="mecanum.h 常量摘要&#xa;&#xa;PERIMETER、WHEELTRACK、WHEELBASE&#xa;ROTATE_X/Y_OFFSET&#xa;MAX_CHASSIS_VX/VY_SPEED (mm/s)&#xa;MAX_CHASSIS_VW_SPEED (°/s)&#xa;MAX_WHEEL_RPM、MOTOR_DECELE_RATIO" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6E6E6;fontSize=11;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;" parent="940R0j_qNuveTOPMAYgD-7" vertex="1">
          <mxGeometry x="1250" y="56" width="520" height="200" as="geometry" />
        </mxCell>
        <mxCell id="940R0j_qNuveTOPMAYgD-11" value="3）四轮速度环 PID&#xa;&#xa;for i in 0..3:&#xa;  反馈：motor[i].data.speed_rpm&#xa;  目标：mecanum.wheel_rpm[i]&#xa;  pid_calculate(motor_pid[i], fb, ref)&#xa;  → motor_set_current(motor[i], current)&#xa;&#xa;PID 参数：chassis_task.c chassis_motor_param&#xa;（P/I/D、max_out、integral_limit）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;fontSize=12;align=left;verticalAlign=top;spacingLeft=14;spacingTop=12;" parent="940R0j_qNuveTOPMAYgD-7" vertex="1">
          <mxGeometry x="50" y="280" width="860" height="200" as="geometry" />
        </mxCell>
        <mxCell id="940R0j_qNuveTOPMAYgD-12" value="4）mecanum_position_measure&#xa;&#xa;用轮编码器反馈 + 陀螺 yaw&#xa;更新里程计（与本图速度环并列执行）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F0F0;fontSize=12;align=left;verticalAlign=top;spacingLeft=14;spacingTop=12;" parent="940R0j_qNuveTOPMAYgD-7" vertex="1">
          <mxGeometry x="940" y="280" width="830" height="200" as="geometry" />
        </mxCell>
        <mxCell id="940R0j_qNuveTOPMAYgD-13" value="④ 执行层" style="swimlane;horizontal=0;startSize=32;fontStyle=1;fontSize=14;fillColor=#F8CECC;strokeColor=#B85450;" parent="1" vertex="1">
          <mxGeometry x="320" y="1350" width="1820" height="140" as="geometry" />
        </mxCell>
        <mxCell id="940R0j_qNuveTOPMAYgD-14" value="CAN2 → C620 / 3508 电调（四轮 0x201–0x204）&#xa;电流闭环跟踪 mecanum 解算得到的各轮目标转速" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;fontSize=12;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;" parent="940R0j_qNuveTOPMAYgD-13" vertex="1">
          <mxGeometry x="50" y="50" width="1720" height="70" as="geometry" />
        </mxCell>
        <mxCell id="940R0j_qNuveTOPMAYgD-15" value="注册：chassis_task 内 soft_timer_register(chassis_pid_calculate, &amp;chassis, 5)；chassis_pid_init 绑定 CAN2 与电机名 Chassis_FR/FL/BL/BR。&#xa;陀螺：chassis_gyro_updata 在任务循环中更新 mecanum.gyro，供位置推算，不直接替代 chassis_set_speed 的 vx,vy,vw。" style="text;html=1;strokeColor=none;fillColor=#FFFFCC;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;fontSize=11;rounded=1;" parent="1" vertex="1">
          <mxGeometry x="320" y="1520" width="1820" height="70" as="geometry" />
        </mxCell>
        <mxCell id="940R0j_qNuveTOPMAYgD-16" value="set_*" style="endArrow=block;html=1;strokeWidth=2;fontSize=11;" parent="1" source="940R0j_qNuveTOPMAYgD-3" target="940R0j_qNuveTOPMAYgD-6" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="940R0j_qNuveTOPMAYgD-17" value="set_*" style="endArrow=block;html=1;strokeWidth=2;fontSize=11;" parent="1" source="940R0j_qNuveTOPMAYgD-4" target="940R0j_qNuveTOPMAYgD-6" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="940R0j_qNuveTOPMAYgD-18" style="endArrow=block;html=1;strokeWidth=2;" parent="1" source="940R0j_qNuveTOPMAYgD-6" target="940R0j_qNuveTOPMAYgD-8" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="940R0j_qNuveTOPMAYgD-19" style="endArrow=block;html=1;strokeWidth=2;" parent="1" source="940R0j_qNuveTOPMAYgD-8" target="940R0j_qNuveTOPMAYgD-9" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="940R0j_qNuveTOPMAYgD-20" style="endArrow=block;html=1;strokeWidth=2;" parent="1" source="940R0j_qNuveTOPMAYgD-9" target="940R0j_qNuveTOPMAYgD-11" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="940R0j_qNuveTOPMAYgD-21" style="endArrow=block;html=1;strokeWidth=2;" parent="1" source="940R0j_qNuveTOPMAYgD-11" target="940R0j_qNuveTOPMAYgD-14" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
