        <mxCell id="eNYUcsIyRo49kigFaYzq-627" value="Set local protocol address (0x01 or 0x02)&#xa;Register all recv cmd callbacks&#xa;Register all offline event tables&#xa;Set route tables (addr-&gt;interface)&#xa;Create communicate_task thread (1ms)" style="rounded=0;fillColor=#DDEEFF;fontSize=10;whiteSpace=wrap;align=left;spacingLeft=5;" parent="eNYUcsIyRo49kigFaYzq-534" vertex="1">
          <mxGeometry x="655" y="1040" width="430" height="100" as="geometry" />
