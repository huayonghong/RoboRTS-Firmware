        </mxCell>
        <mxCell id="wqBeYj-3dv2jAloqyC1d-33" value="CAN1" style="endArrow=block;html=1;strokeWidth=3;fontSize=11;strokeColor=#1F4788;startArrow=block;startFill=1;" parent="wqBeYj-3dv2jAloqyC1d-21" source="WbKpN1WQK_JBk0jXsQlg-2" target="WbKpN1WQK_JBk0jXsQlg-3" edge="1">
