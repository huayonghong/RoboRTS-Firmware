          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="YSryUHNdWHgZ00otxvq7-72" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;strokeWidth=2;" parent="YSryUHNdWHgZ00otxvq7-63" source="YSryUHNdWHgZ00otxvq7-66" target="YSryUHNdWHgZ00otxvq7-67" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="YSryUHNdWHgZ00otxvq7-73" value="随动控制链" style="edgeLabel;html=1;fontSize=11;fontStyle=1" parent="YSryUHNdWHgZ00otxvq7-72" vertex="1" connectable="0">
