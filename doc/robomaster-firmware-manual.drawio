        <mxCell id="eNYUcsIyRo49kigFaYzq-630" value="Protocol CRC mismatch -&gt; drop&#xa;Protocol ACK timeout -&gt; resend&#xa;Referee invalid frame -&gt; discard" style="rounded=0;fillColor=#DDEEFF;fontSize=10;whiteSpace=wrap;" parent="eNYUcsIyRo49kigFaYzq-534" vertex="1">
