        <mxCell id="YSryUHNdWHgZ00otxvq7-51" value="task_init() 分支&#xa;&#xa;if (get_sys_cfg()&#xa;    == CHASSIS_APP)&#xa;    chassis_app_init();&#xa;else&#xa;    gimbal_app_init();" style="rhombus;whiteSpace=wrap;html=1;fillColor=#F8CECC;fontSize=12;spacingTop=4;" parent="YSryUHNdWHgZ00otxvq7-48" vertex="1">
          <mxGeometry x="620" y="55" width="280" height="150" as="geometry" />
