        <mxCell id="eNYUcsIyRo49kigFaYzq-610" value="application/chassis/&#xa;chassis_app.c" style="rounded=0;fillColor=#D5E8D4;fontSize=10;whiteSpace=wrap;" parent="eNYUcsIyRo49kigFaYzq-534" vertex="1">
          <mxGeometry x="470" y="745" width="180" height="130" as="geometry" />
        </mxCell>
        <mxCell id="eNYUcsIyRo49kigFaYzq-611" value="Register CAN1 protocol interface&#xa;(RX 0x500 / TX 0x600)&#xa;Create chassis_task thread.&#xa;Inside task: register 4 motors on CAN2&#xa;(0x201-0x204), start mecanum PID.&#xa;Register follow PID." style="rounded=0;fillColor=#D5E8D4;fontSize=10;whiteSpace=wrap;align=left;spacingLeft=5;" parent="eNYUcsIyRo49kigFaYzq-534" vertex="1">
          <mxGeometry x="655" y="745" width="430" height="130" as="geometry" />
        </mxCell>
        <mxCell id="eNYUcsIyRo49kigFaYzq-612" value="CAN1 protocol (0x500/0x600),&#xa;4x Chassis motors (CAN2),&#xa;RC device, DBUS subscriber,&#xa;AHRS subscriber,&#xa;chassis_pid_calculate (5ms timer),&#xa;chassis_angle_broadcast (10ms)" style="rounded=0;fillColor=#D5E8D4;fontSize=10;whiteSpace=wrap;align=left;spacingLeft=5;" parent="eNYUcsIyRo49kigFaYzq-534" vertex="1">
          <mxGeometry x="1090" y="745" width="370" height="130" as="geometry" />
        </mxCell>
        <mxCell id="eNYUcsIyRo49kigFaYzq-613" value="Motor detection: offline_service checks&#xa;CAN2 RX for 0x201-0x204 every 100ms.&#xa;If no feedback -&gt; OFFLINE, beep alarm.&#xa;DBUS: timeout 100ms -&gt; OFFLINE.&#xa;Gimbal info: timeout 700ms check." style="rounded=0;fillColor=#D5E8D4;fontSize=10;whiteSpace=wrap;align=left;spacingLeft=5;" parent="eNYUcsIyRo49kigFaYzq-534" vertex="1">
          <mxGeometry x="1465" y="745" width="400" height="130" as="geometry" />
        </mxCell>
        <mxCell id="eNYUcsIyRo49kigFaYzq-614" value="SYSTEM_PROTECT event:&#xa;if any ERROR_LEVEL device offline&#xa;-&gt; chassis_disable() stops all motors.&#xa;Beep times = device beep_times.&#xa;LED_R on when offline." style="rounded=0;fillColor=#D5E8D4;fontSize=10;whiteSpace=wrap;align=left;spacingLeft=5;" parent="eNYUcsIyRo49kigFaYzq-534" vertex="1">
          <mxGeometry x="1870" y="745" width="380" height="130" as="geometry" />
        </mxCell>
        <mxCell id="eNYUcsIyRo49kigFaYzq-615" value="9b" style="rounded=0;fillColor=#E1D5E7;fontSize=11;whiteSpace=wrap;fontStyle=1;" parent="eNYUcsIyRo49kigFaYzq-534" vertex="1">
          <mxGeometry x="10" y="880" width="50" height="155" as="geometry" />
        </mxCell>
        <mxCell id="eNYUcsIyRo49kigFaYzq-616" value="App Init&#xa;[Gimbal Mode]&#xa;task_init()&#xa;(RTOS)" style="rounded=0;fillColor=#E1D5E7;fontSize=11;whiteSpace=wrap;fontStyle=1;" parent="eNYUcsIyRo49kigFaYzq-534" vertex="1">
          <mxGeometry x="65" y="880" width="135" height="155" as="geometry" />
        </mxCell>
        <mxCell id="eNYUcsIyRo49kigFaYzq-617" value="gimbal_app_init():&#xa;  protocol_can_interface_register()&#xa;  soft_timer_register(gimbal_info)&#xa;  osThreadCreate(GIMBAL_TASK)&#xa;  osThreadCreate(SHOOT_TASK)" style="rounded=0;fillColor=#E1D5E7;fontSize=10;whiteSpace=wrap;align=left;spacingLeft=5;" parent="eNYUcsIyRo49kigFaYzq-534" vertex="1">
          <mxGeometry x="205" y="880" width="260" height="155" as="geometry" />
        </mxCell>
        <mxCell id="eNYUcsIyRo49kigFaYzq-618" value="application/gimbal/&#xa;gimbal_app.c" style="rounded=0;fillColor=#E1D5E7;fontSize=10;whiteSpace=wrap;" parent="eNYUcsIyRo49kigFaYzq-534" vertex="1">
          <mxGeometry x="470" y="880" width="180" height="155" as="geometry" />
        </mxCell>
        <mxCell id="eNYUcsIyRo49kigFaYzq-619" value="Register CAN1 protocol interface&#xa;(RX 0x600 / TX 0x500)&#xa;Create gimbal_task: register Yaw(0x205)&#xa;+ Pitch(0x206), cascade PID init.&#xa;Create shoot_task: register Turn(0x207),&#xa;friction PWM init.&#xa;Read gimbal center from EasyFlash.&#xa;If no saved params -&gt; ADJUST_MODE." style="rounded=0;fillColor=#E1D5E7;fontSize=10;whiteSpace=wrap;align=left;spacingLeft=5;" parent="eNYUcsIyRo49kigFaYzq-534" vertex="1">
          <mxGeometry x="655" y="880" width="430" height="155" as="geometry" />
        </mxCell>
        <mxCell id="eNYUcsIyRo49kigFaYzq-620" value="CAN1 protocol (0x600/0x500),&#xa;Yaw motor 0x205 (CAN2),&#xa;Pitch motor 0x206 (CAN2),&#xa;Turn motor 0x207 (CAN2),&#xa;single_gyro (CAN1 0x401),&#xa;RC device, DBUS/AHRS subscribers,&#xa;shoot_pid_calculate (5ms timer),&#xa;Friction PWM (TIM8)" style="rounded=0;fillColor=#E1D5E7;fontSize=10;whiteSpace=wrap;align=left;spacingLeft=5;" parent="eNYUcsIyRo49kigFaYzq-534" vertex="1">
          <mxGeometry x="1090" y="880" width="370" height="155" as="geometry" />
        </mxCell>
        <mxCell id="eNYUcsIyRo49kigFaYzq-621" value="Yaw motor: offline check 100ms (beep 5)&#xa;Pitch motor: offline check 100ms (beep 6)&#xa;Turn motor: offline check 100ms (beep 7)&#xa;DBUS: offline check 100ms&#xa;Manifold2 heart: 700ms (disabled by def)&#xa;Gimbal adjust: read EasyFlash center&#xa;  if no data -&gt; auto-adjust mode." style="rounded=0;fillColor=#E1D5E7;fontSize=10;whiteSpace=wrap;align=left;spacingLeft=5;" parent="eNYUcsIyRo49kigFaYzq-534" vertex="1">
          <mxGeometry x="1465" y="880" width="400" height="155" as="geometry" />
        </mxCell>
        <mxCell id="eNYUcsIyRo49kigFaYzq-622" value="SYSTEM_PROTECT: if any motor or&#xa;DBUS offline -&gt; gimbal_offline()&#xa;disables Yaw/Pitch/Shoot PIDs.&#xa;When DBUS comes online first time&#xa;-&gt; gimbal_init_start() ramp to center.&#xa;LED_B on when Manifold2 offline." style="rounded=0;fillColor=#E1D5E7;fontSize=10;whiteSpace=wrap;align=left;spacingLeft=5;" parent="eNYUcsIyRo49kigFaYzq-534" vertex="1">
          <mxGeometry x="1870" y="880" width="380" height="155" as="geometry" />
        </mxCell>
