        <mxCell id="eNYUcsIyRo49kigFaYzq-603" value="Create 4 FreeRTOS threads:&#xa;1. CLI shell (USART1 debug)&#xa;2. Offline monitor (20ms cycle)&#xa;3. Soft timer task (1ms tick)&#xa;4. Sensor task (1ms IMU read)" style="rounded=0;fillColor=#FFFFFF;fontSize=10;whiteSpace=wrap;align=left;spacingLeft=5;" parent="eNYUcsIyRo49kigFaYzq-534" vertex="1">
