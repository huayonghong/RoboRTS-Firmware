        <mxCell id="eNYUcsIyRo49kigFaYzq-629" value="Protocol cmd table integrity&#xa;Route table address matching&#xa;Referee FIFO buffer check" style="rounded=0;fillColor=#DDEEFF;fontSize=10;whiteSpace=wrap;" parent="eNYUcsIyRo49kigFaYzq-534" vertex="1">
