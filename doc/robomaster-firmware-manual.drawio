          <mxGeometry x="1090" y="640" width="370" height="100" as="geometry" />
        </mxCell>
        <mxCell id="eNYUcsIyRo49kigFaYzq-605" value="Sensor: BMI088 gyro zero offset cal&#xa;(~1s blocking at startup).&#xa;Offline: all devices set STATE_OFFLINE&#xa;until first data received." style="rounded=0;fillColor=#FFFFFF;fontSize=10;whiteSpace=wrap;align=left;spacingLeft=5;" parent="eNYUcsIyRo49kigFaYzq-534" vertex="1">
