        <mxCell id="eNYUcsIyRo49kigFaYzq-606" value="Sensor: blocked until gyro&#xa;offset converges.&#xa;Timer: Stack overflow hook." style="rounded=0;fillColor=#FFFFFF;fontSize=10;whiteSpace=wrap;" parent="eNYUcsIyRo49kigFaYzq-534" vertex="1">
