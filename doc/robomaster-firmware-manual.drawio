        <mxCell id="eNYUcsIyRo49kigFaYzq-609" value="chassis_app_init():&#xa;  protocol_can_interface_register()&#xa;  soft_timer_register(chassis_info)&#xa;  osThreadCreate(CHASSIS_TASK)" style="rounded=0;fillColor=#D5E8D4;fontSize=10;whiteSpace=wrap;align=left;spacingLeft=5;" parent="eNYUcsIyRo49kigFaYzq-534" vertex="1">
          <mxGeometry x="205" y="745" width="260" height="130" as="geometry" />
