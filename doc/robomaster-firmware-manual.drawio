        <mxCell id="WbKpN1WQK_JBk0jXsQlg-7" value="&amp;lt;&amp;lt;设备&amp;gt;&amp;gt;&lt;br&gt;遥控器 + 接收机（DBUS）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F0F0;strokeColor=#666666;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="wqBeYj-3dv2jAloqyC1d-21">
          <mxGeometry x="140" y="850" width="240" height="100" as="geometry" />
        </mxCell>
        <mxCell id="WbKpN1WQK_JBk0jXsQlg-8" value="&lt;span style=&quot;&quot;&gt;&amp;lt;&amp;lt;设备&amp;gt;&amp;gt;&lt;/span&gt;&lt;br style=&quot;&quot;&gt;&lt;span style=&quot;&quot;&gt;机载电脑 / 上位机&lt;/span&gt;&lt;br style=&quot;&quot;&gt;&lt;span style=&quot;&quot;&gt;(MANIFOLD2_ADDRESS)&lt;/span&gt;&lt;br style=&quot;&quot;&gt;&lt;br style=&quot;&quot;&gt;&lt;span style=&quot;&quot;&gt;· 典型：USB 接底盘板&lt;/span&gt;&lt;br style=&quot;&quot;&gt;&lt;span style=&quot;&quot;&gt;· 协议：CMD_SET_CHASSIS_*、&lt;/span&gt;&lt;br style=&quot;&quot;&gt;&lt;span style=&quot;&quot;&gt;CMD_PUSH_CHASSIS_INFO、&lt;/span&gt;&lt;br style=&quot;&quot;&gt;&lt;span style=&quot;&quot;&gt;裁判转发 cmd+0x4000 等&lt;/span&gt;&lt;br style=&quot;&quot;&gt;&lt;span style=&quot;&quot;&gt;· 若仅云台 USB：需在云台侧&lt;/span&gt;&lt;br style=&quot;&quot;&gt;&lt;span style=&quot;&quot;&gt;增加 CHASSIS 路由扩展&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F0F0;strokeColor=#666666;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="wqBeYj-3dv2jAloqyC1d-21">
