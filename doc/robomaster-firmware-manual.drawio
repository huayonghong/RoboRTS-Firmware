  <diagram id="TOBQqEydaHlgJ4yB1TQU" name="地盘随动模式">
    <mxGraphModel dx="2305" dy="1243" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="kGnfXo39ut4HiMZHzzJg-1" value="底盘「随动」模式开启后：云台如何动、程序如何处理&#xa;（随动 = chassis_task 中遥控器三挡开关 S2 = UP；与云台板固件并行运行）" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontStyle=1;fontSize=17;spacingTop=8;" parent="1" vertex="1">
          <mxGeometry x="440" y="310" width="1480" height="65" as="geometry" />
        </mxCell>
        <mxCell id="kGnfXo39ut4HiMZHzzJg-2" value="概念区分&#xa;&#xa;· 底盘随动：车体用 yaw 角速度 wz 跟踪云台编码器 yaw（follow_relative_angle），代码在「底盘 MCU」的 chassis_task。&#xa;· 云台侧 RC_S2_UP：注释为 follow mode，实为云台 Yaw 陀螺模式 + 摇杆增量，代码在「云台 MCU」的 gimbal_normol_handle；与底盘是否随动无直接调用关系。&#xa;· 云台电机电流始终由云台板 gimbal_cascade_calculate → CAN2 下发，底盘任务不会直接驱动云台电机。" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=16;spacingTop=12;fillColor=#FFF4CC;fontSize=12;strokeColor=#D6B656;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="440" y="390" width="1480" height="140" as="geometry" />
        </mxCell>
        <mxCell id="kGnfXo39ut4HiMZHzzJg-3" value="云台 MCU — 云台如何运动（底盘随动与否均可运行）" style="swimlane;horizontal=0;startSize=34;fontSize=13;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="440" y="555" width="1480" height="380" as="geometry" />
        </mxCell>
        <mxCell id="kGnfXo39ut4HiMZHzzJg-4" value="周期：osDelayUntil 5ms（GIMBAL_PERIOD）" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#E1D5E7;" parent="kGnfXo39ut4HiMZHzzJg-3" vertex="1">
          <mxGeometry x="40" y="55" width="280" height="55" as="geometry" />
        </mxCell>
        <mxCell id="kGnfXo39ut4HiMZHzzJg-5" value="DBUS_MSG → gimbal_dr16_data_update&#xa;→ rc_device_date_update（gimbal_rc）" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#F5F5F5;align=left;spacingLeft=12;" parent="kGnfXo39ut4HiMZHzzJg-3" vertex="1">
          <mxGeometry x="350" y="50" width="360" height="70" as="geometry" />
        </mxCell>
        <mxCell id="kGnfXo39ut4HiMZHzzJg-6" value="AHRS_MSG → 陀螺姿态&#xa;→ gimbal_pitch_gyro_update&#xa;→ gimbal_rate_update" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#F5F5F5;align=left;spacingLeft=12;" parent="kGnfXo39ut4HiMZHzzJg-3" vertex="1">
          <mxGeometry x="740" y="50" width="340" height="85" as="geometry" />
        </mxCell>
        <mxCell id="kGnfXo39ut4HiMZHzzJg-7" value="switch(gimbal_mode)&#xa;NORMAL_MODE：&#xa;  gimbal_normol_handle（按云台 RC S2）&#xa;  · S2 UP：Yaw=GYRO_MODE，ch3/ch4→pitch/yaw delta&#xa;  · S2 MID：Yaw=ENCODER_MODE&#xa;  · S2 DOWN：SDK / 离线策略&#xa;  gimbal_cascade_calculate → 云台 PID&#xa;INIT / ADJUST：回中或标定分支" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=left;spacingLeft=14;spacingTop=10;fillColor=#FFFFFF;verticalAlign=top;" parent="kGnfXo39ut4HiMZHzzJg-3" vertex="1">
          <mxGeometry x="40" y="155" width="680" height="195" as="geometry" />
        </mxCell>
        <mxCell id="kGnfXo39ut4HiMZHzzJg-8" value="底盘来的 yaw 辅助（可选）&#xa;&#xa;CAN1 收 0x401&#xa;→ gimbal_can1_callback&#xa;→ gimbal_gyro_yaw_update&#xa;→ single_gyro + gimbal_yaw_gyro_update&#xa;（与车体坐标系 yaw 对齐/融合）" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=left;spacingLeft=14;spacingTop=10;fillColor=#E1D5E7;verticalAlign=top;" parent="kGnfXo39ut4HiMZHzzJg-3" vertex="1">
          <mxGeometry x="760" y="155" width="400" height="195" as="geometry" />
        </mxCell>
        <mxCell id="kGnfXo39ut4HiMZHzzJg-9" value="输出&#xa;&#xa;motor_set_current（yaw/pitch/拨弹）&#xa;→ 1ms motor_can_output(CAN2)&#xa;云台物理运动" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=left;spacingLeft=12;fillColor=#D5E8D4;verticalAlign=top;" parent="kGnfXo39ut4HiMZHzzJg-3" vertex="1">
          <mxGeometry x="1190" y="155" width="250" height="195" as="geometry" />
