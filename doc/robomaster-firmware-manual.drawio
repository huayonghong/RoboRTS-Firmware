        </mxCell>
        <mxCell id="eNYUcsIyRo49kigFaYzq-588" value="USART1(DMA), USART6(DMA),&#xa;CAN1(filter+IRQ), CAN2(filter+IRQ),&#xa;TIM8 CH2/3, TIM10 CH1, TIM4 CH3,&#xa;BMI088 via SPI1,&#xa;Soft timer system,&#xa;Event system (DBUS_MSG, UWB_MSG),&#xa;Protocol USB interface" style="rounded=0;fillColor=#FFFFFF;fontSize=10;whiteSpace=wrap;align=left;spacingLeft=5;" parent="eNYUcsIyRo49kigFaYzq-534" vertex="1">
