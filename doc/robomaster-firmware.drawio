                    <mxGeometry x="40" y="55" width="260" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="boot2" value="hw_init()&#10;&#10;board_config()&#10;· 日志 USART / CAN / PWM / BMI088&#10;· protocol、SoftTimer、电机 CAN 1ms、DBus&#10;&#10;system_config()&#10;· 读 GPIO → 决定 APP 类型&#10;&#10;easyflash_init()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;fontSize=12;spacingTop=6;spacingBottom=6;align=left;spacingLeft=10;" parent="lane-boot" vertex="1">
                    <mxGeometry x="340" y="45" width="420" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="boot3" value="sys_task()&#10;&#10;· thread_cli_init&#10;· offline_service_task_init&#10;· soft_timer_FreeRTOS_init&#10;· sensor_task_init" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;fontSize=12;spacingTop=6;spacingBottom=6;align=left;spacingLeft=10;" parent="lane-boot" vertex="1">
                    <mxGeometry x="800" y="55" width="300" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="boot4" value="task_init()&#10;&#10;· 按 get_sys_cfg() 选择&#10;  chassis_app_init() 或&#10;  gimbal_app_init()&#10;&#10;· app_protocol_init()&#10;· communicate_task_init()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;fontSize=12;spacingTop=6;spacingBottom=6;align=left;spacingLeft=10;" parent="lane-boot" vertex="1">
