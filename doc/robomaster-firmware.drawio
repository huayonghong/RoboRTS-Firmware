                <mxCell id="lane-boot" value="1. 复位入口（FreeRTOS）" style="swimlane;horizontal=0;startSize=32;fontSize=13;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontStyle=1;" parent="1" vertex="1">
